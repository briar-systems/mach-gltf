# the flat public surface of the glTF 2.0 loader
#
# re-exports every public symbol of the split modules under one namespace so a
# bare `use gltf;` reaches the whole API as gltf.MAGIC, gltf.Header, and so on.
# `[project].module = "gltf.mach"` makes that bare import resolve here.

use gltf.accessor;
use gltf.doc;
use gltf.glb;
use gltf.parse;
# links the startup entrypoint so `mach test` over this library produces a binary.
use std.runtime;

fwd glb.MAGIC;
fwd glb.VERSION;
fwd glb.CHUNK_JSON;
fwd glb.CHUNK_BIN;
fwd glb.HEADER_SIZE;
fwd glb.CHUNK_HEADER_SIZE;
fwd glb.ContainerError;
fwd glb.Header;
fwd glb.Chunk;
fwd glb.ChunkIter;
fwd glb.Glb;
fwd glb.is_valid;
fwd glb.read_header;
fwd glb.chunk_iter;
fwd glb.chunk_next;
fwd glb.parse_glb;

fwd doc.MAX_COMPONENTS;
fwd doc.ComponentType;
fwd doc.AccessorType;
fwd doc.PrimitiveMode;
fwd doc.BufferTarget;
fwd doc.MagFilter;
fwd doc.MinFilter;
fwd doc.WrapMode;
fwd doc.Interpolation;
fwd doc.TargetPath;
fwd doc.AlphaMode;
fwd doc.component_count;
fwd doc.component_size;
fwd doc.element_size;
fwd doc.scalar_count;
fwd doc.Asset;
fwd doc.Buffer;
fwd doc.BufferView;
fwd doc.Accessor;
fwd doc.Attribute;
fwd doc.MorphTarget;
fwd doc.Primitive;
fwd doc.Mesh;
fwd doc.Node;
fwd doc.Scene;
fwd doc.TextureRef;
fwd doc.PbrMetallicRoughness;
fwd doc.Material;
fwd doc.Texture;
fwd doc.Image;
fwd doc.Sampler;
fwd doc.Skin;
fwd doc.AnimationSampler;
fwd doc.AnimationChannel;
fwd doc.Animation;
fwd doc.Document;

fwd parse.Site;
fwd parse.DocumentError;
fwd parse.LoadError;
fwd parse.Loaded;
fwd parse.parse_document;
fwd parse.load_glb;

fwd accessor.PlanError;
fwd accessor.ReadError;
fwd accessor.Plan;
fwd accessor.plan;
fwd accessor.read_f32;
fwd accessor.read_u32;
fwd accessor.read_u16;
fwd accessor.read_u8;
