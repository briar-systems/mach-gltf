# gltf.gltf: the flat public surface of the glTF 2.0 loader.
#
# re-exports every public symbol of the split modules under one namespace so a
# bare `use gltf;` reaches the whole API as gltf.MAGIC, gltf.Header, and so on.
# `[project].module = "gltf.mach"` makes that bare import resolve here.

use gltf.glb;
use gltf.doc;
use gltf.parse;
# links the startup entrypoint so `mach test` over this library produces a binary.
use std.runtime;

fwd glb.MAGIC;
fwd glb.VERSION;
fwd glb.CHUNK_JSON;
fwd glb.CHUNK_BIN;
fwd glb.HEADER_SIZE;
fwd glb.CHUNK_HEADER_SIZE;
fwd glb.Header;
fwd glb.Chunk;
fwd glb.ChunkIter;
fwd glb.Glb;
fwd glb.is_valid;
fwd glb.read_header;
fwd glb.chunk_iter;
fwd glb.chunk_next;
fwd glb.parse_glb;

fwd doc.NONE;
fwd doc.MAX_COMPONENTS;
fwd doc.ComponentType;
fwd doc.COMPONENT_BYTE;
fwd doc.COMPONENT_UNSIGNED_BYTE;
fwd doc.COMPONENT_SHORT;
fwd doc.COMPONENT_UNSIGNED_SHORT;
fwd doc.COMPONENT_UNSIGNED_INT;
fwd doc.COMPONENT_FLOAT;
fwd doc.AccessorType;
fwd doc.TYPE_SCALAR;
fwd doc.TYPE_VEC2;
fwd doc.TYPE_VEC3;
fwd doc.TYPE_VEC4;
fwd doc.TYPE_MAT2;
fwd doc.TYPE_MAT3;
fwd doc.TYPE_MAT4;
fwd doc.PrimitiveMode;
fwd doc.MODE_POINTS;
fwd doc.MODE_LINES;
fwd doc.MODE_LINE_LOOP;
fwd doc.MODE_LINE_STRIP;
fwd doc.MODE_TRIANGLES;
fwd doc.MODE_TRIANGLE_STRIP;
fwd doc.MODE_TRIANGLE_FAN;
fwd doc.Interpolation;
fwd doc.INTERP_LINEAR;
fwd doc.INTERP_STEP;
fwd doc.INTERP_CUBICSPLINE;
fwd doc.TargetPath;
fwd doc.PATH_TRANSLATION;
fwd doc.PATH_ROTATION;
fwd doc.PATH_SCALE;
fwd doc.PATH_WEIGHTS;
fwd doc.AlphaMode;
fwd doc.ALPHA_OPAQUE;
fwd doc.ALPHA_MASK;
fwd doc.ALPHA_BLEND;
fwd doc.component_count;
fwd doc.component_size;
fwd doc.element_size;
fwd doc.Asset;
fwd doc.Buffer;
fwd doc.BufferView;
fwd doc.Accessor;
fwd doc.Attribute;
fwd doc.MorphTarget;
fwd doc.Primitive;
fwd doc.Mesh;
fwd doc.Node;
fwd doc.Scene;
fwd doc.TextureRef;
fwd doc.PbrMetallicRoughness;
fwd doc.Material;
fwd doc.Texture;
fwd doc.Image;
fwd doc.Sampler;
fwd doc.Skin;
fwd doc.AnimationSampler;
fwd doc.AnimationChannel;
fwd doc.Animation;
fwd doc.Document;

fwd parse.Loaded;
fwd parse.parse_document;
fwd parse.load_glb;
