# build a document model from glTF JSON
#
# walks a std.data.json Value tree into the typed gltf.doc records. numbers
# come straight from the parser (integers via value_number, floats widened via
# value_float), strings are copied into owned null-terminated `str` from the
# caller's allocator, and so is every array. nothing in the result points into
# the JSON bytes, so the caller may free or reuse them as soon as parsing
# returns. an arena freed wholesale is the intended lifetime discipline,
# matching std.data.json's own Value tree.
#
# strings were borrowed views into the input until the document model was made
# self-contained. borrowing cost nothing to produce and cost every consumer a
# non-standard string type plus a lifetime tie to a buffer they did not own.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.size.usize;
use std.types.char.char;
use std.types.string.str;
use std.types.string.str_equals;
use text: std.text.string;
use std.types.result.Result;
use std.types.result.ok;
use std.types.result.err;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use std.types.result.unwrap_err;
use json:     std.data.json;
use allo:     std.allocator;
use slice:    std.collections.slice;
use doc:      gltf.doc;
use glb:      gltf.glb;
use bytes:    gltf.bytes;
use accessor: gltf.accessor;
use page:     std.allocator.page;

# a document parsed from a .glb together with its binary buffer
# ---
# document: the parsed glTF document
# bin:      pointer to the BIN chunk bytes, or nil when the container had none
# bin_len:  BIN chunk length in bytes, or 0 when absent
pub rec Loaded {
    document: doc.Document;
    bin:      *u8;
    bin_len:  usize;
}

# read an integer member, or dflt when absent or not a number
fun get_i64(obj: *json.Value, key: str, dflt: i64) i64 {
    val m: *json.Value = json.value_find(obj, key);
    if (m == nil) { ret dflt; }
    if (!json.value_is_number(m)) { ret dflt; }
    ret json.value_number(m);
}

# read a non-negative integer member, or dflt when absent or invalid
fun get_usize(obj: *json.Value, key: str, dflt: usize) usize {
    val n: i64 = get_i64(obj, key, dflt::i64);
    if (n < 0) { ret dflt; }
    ret n::usize;
}

# read an optional index member, NONE when absent
fun get_index(obj: *json.Value, key: str) i64 {
    ret get_i64(obj, key, doc.NONE);
}

# read a float member (int or float), or dflt when absent or not a number
fun get_f32(obj: *json.Value, key: str, dflt: f32) f32 {
    val m: *json.Value = json.value_find(obj, key);
    if (m == nil) { ret dflt; }
    if (!json.value_is_number(m)) { ret dflt; }
    ret json.value_float(m)::f32;
}

# read a boolean member, or dflt when absent or not a boolean
fun get_bool(obj: *json.Value, key: str, dflt: bool) bool {
    val m: *json.Value = json.value_find(obj, key);
    if (m == nil) { ret dflt; }
    if (!json.value_is_bool(m)) { ret dflt; }
    ret json.value_bool(m);
}

# read a string member as an owned copy, an owned empty string when absent
#
# the JSON value carries a pointer and a length into the source bytes and is
# not null-terminated, so this copies rather than borrows: str_dup_range takes
# the length explicitly and never scans for a terminator.
#
# returns nil ONLY on allocation failure, never for an absent member. callers
# allocate several strings in a row and test them together before returning,
# which keeps the failure check to one line per record instead of three per
# field.
fun get_str(obj: *json.Value, key: str, alloc: *allo.Allocator) str {
    var len: usize = 0;
    var p:   *u8   = nil;
    val m: *json.Value = json.value_find(obj, key);
    if (m != nil && json.value_is_string(m)) { p = json.value_string(m, ?len); }
    val r: Result[str, str] = text.str_dup_range(alloc, p::str, 0, len);
    if (is_err[str, str](r)) { ret nil; }
    ret unwrap_ok[str, str](r);
}

# the i-th object key as an owned copy
fun key_own(obj: *json.Value, i: usize, alloc: *allo.Allocator) str {
    val k:    str   = json.value_key(obj, i);
    val klen: usize = json.value_key_len(obj, i);
    val r: Result[str, str] = text.str_dup_range(alloc, k, 0, klen);
    if (is_err[str, str](r)) { ret nil; }
    ret unwrap_ok[str, str](r);
}

# copy up to cap numbers from a JSON array into out, returning the count
fun read_floats(arr: *json.Value, out: *f32, cap: usize) usize {
    if (arr == nil || !json.value_is_array(arr)) { ret 0; }
    var n: usize = json.value_count(arr);
    if (n > cap) { n = cap; }
    var i: usize = 0;
    for (i < n) {
        val e: *json.Value = json.value_get(arr, i);
        if (e != nil && json.value_is_number(e)) {
            out[i] = json.value_float(e)::f32;
        } or {
            out[i] = 0.0f32;
        }
        i = i + 1;
    }
    ret n;
}

# copy a member array of numbers into out, returning the count
fun read_float_member(obj: *json.Value, key: str, out: *f32, cap: usize) usize {
    ret read_floats(json.value_find(obj, key), out, cap);
}

# allocate a Slice[i64] from a member array of indices
fun parse_index_slice(obj: *json.Value, key: str, alloc: *allo.Allocator) Result[slice.Slice[i64], str] {
    val arr: *json.Value = json.value_find(obj, key);
    if (arr == nil || !json.value_is_array(arr)) { ret ok[slice.Slice[i64], str](slice.make[i64](nil, 0)); }
    val n: usize = json.value_count(arr);
    if (n == 0) { ret ok[slice.Slice[i64], str](slice.make[i64](nil, 0)); }

    val ar: Result[*i64, str] = allo.allocate[i64](alloc, n);
    if (is_err[*i64, str](ar)) { ret err[slice.Slice[i64], str](unwrap_err[*i64, str](ar)); }
    val data: *i64 = unwrap_ok[*i64, str](ar);

    var i: usize = 0;
    for (i < n) {
        val e: *json.Value = json.value_get(arr, i);
        if (e != nil && json.value_is_number(e)) {
            data[i] = json.value_number(e);
        } or {
            data[i] = doc.NONE;
        }
        i = i + 1;
    }
    ret ok[slice.Slice[i64], str](slice.make[i64](data, n));
}

# allocate a Slice[f32] from a member array of numbers
fun parse_float_slice(obj: *json.Value, key: str, alloc: *allo.Allocator) Result[slice.Slice[f32], str] {
    val arr: *json.Value = json.value_find(obj, key);
    if (arr == nil || !json.value_is_array(arr)) { ret ok[slice.Slice[f32], str](slice.make[f32](nil, 0)); }
    val n: usize = json.value_count(arr);
    if (n == 0) { ret ok[slice.Slice[f32], str](slice.make[f32](nil, 0)); }

    val ar: Result[*f32, str] = allo.allocate[f32](alloc, n);
    if (is_err[*f32, str](ar)) { ret err[slice.Slice[f32], str](unwrap_err[*f32, str](ar)); }
    val data: *f32 = unwrap_ok[*f32, str](ar);

    read_floats(arr, data, n);
    ret ok[slice.Slice[f32], str](slice.make[f32](data, n));
}

# read a material texture reference object member
fun parse_texture_ref(obj: *json.Value, key: str) doc.TextureRef {
    var t: doc.TextureRef;
    t.index = doc.NONE;
    t.tex_coord = 0;
    val m: *json.Value = json.value_find(obj, key);
    if (m == nil || !json.value_is_object(m)) { ret t; }
    t.index = get_index(m, "index");
    t.tex_coord = get_i64(m, "texCoord", 0);
    ret t;
}

# read the top-level asset metadata
fun parse_asset(root: *json.Value, alloc: *allo.Allocator) Result[doc.Asset, str] {
    var a: doc.Asset;
    # a missing asset object still yields owned empty strings, so every field
    # of a returned Document is a valid str regardless of what the input omitted
    var m: *json.Value = json.value_find(root, "asset");
    if (m != nil && !json.value_is_object(m)) { m = nil; }
    a.version     = get_str(m, "version",    alloc);
    a.min_version = get_str(m, "minVersion", alloc);
    a.generator   = get_str(m, "generator",  alloc);
    a.copyright   = get_str(m, "copyright",  alloc);
    if (a.version == nil || a.min_version == nil || a.generator == nil || a.copyright == nil) {
        ret err[doc.Asset, str]("out of memory reading asset strings");
    }
    ret ok[doc.Asset, str](a);
}

# read one buffer definition
fun parse_buffer(e: *json.Value, alloc: *allo.Allocator) Result[doc.Buffer, str] {
    var b: doc.Buffer;
    b.byte_length = get_usize(e, "byteLength", 0);
    b.uri  = get_str(e, "uri",  alloc);
    b.name = get_str(e, "name", alloc);
    if (b.uri == nil || b.name == nil) { ret err[doc.Buffer, str]("out of memory reading buffer strings"); }
    ret ok[doc.Buffer, str](b);
}

# read one buffer view definition
fun parse_buffer_view(e: *json.Value, alloc: *allo.Allocator) Result[doc.BufferView, str] {
    var v: doc.BufferView;
    v.buffer = get_index(e, "buffer");
    v.byte_offset = get_usize(e, "byteOffset", 0);
    v.byte_length = get_usize(e, "byteLength", 0);
    v.byte_stride = get_usize(e, "byteStride", 0);
    v.target = get_index(e, "target");
    v.name = get_str(e, "name", alloc);
    if (v.name == nil) { ret err[doc.BufferView, str]("out of memory reading bufferView name"); }
    ret ok[doc.BufferView, str](v);
}

# map a glTF accessor type string to an AccessorType
# ---
# ret: the matching type, or an error for an unrecognized string
fun accessor_type(v: str) Result[doc.AccessorType, str] {
    if (str_equals(v, "SCALAR")) { ret ok[doc.AccessorType, str](doc.TYPE_SCALAR); }
    if (str_equals(v, "VEC2"))   { ret ok[doc.AccessorType, str](doc.TYPE_VEC2); }
    if (str_equals(v, "VEC3"))   { ret ok[doc.AccessorType, str](doc.TYPE_VEC3); }
    if (str_equals(v, "VEC4"))   { ret ok[doc.AccessorType, str](doc.TYPE_VEC4); }
    if (str_equals(v, "MAT2"))   { ret ok[doc.AccessorType, str](doc.TYPE_MAT2); }
    if (str_equals(v, "MAT3"))   { ret ok[doc.AccessorType, str](doc.TYPE_MAT3); }
    if (str_equals(v, "MAT4"))   { ret ok[doc.AccessorType, str](doc.TYPE_MAT4); }
    ret err[doc.AccessorType, str]("unknown accessor type");
}

# read one accessor definition, including optional min/max bounds
# ---
# ret: the accessor, or an error for an unrecognized element type
fun parse_accessor(e: *json.Value, alloc: *allo.Allocator) Result[doc.Accessor, str] {
    var a: doc.Accessor;
    a.buffer_view = get_index(e, "bufferView");
    a.byte_offset = get_usize(e, "byteOffset", 0);
    a.component_type = get_i64(e, "componentType", 0)::doc.ComponentType;
    a.normalized = get_bool(e, "normalized", false);
    a.count = get_usize(e, "count", 0);
    a.bounds_len = 0;
    a.has_min = false;
    a.has_max = false;
    a.name = get_str(e, "name", alloc);
    if (a.name == nil) { ret err[doc.Accessor, str]("out of memory reading accessor name"); }

    val ty: str = get_str(e, "type", alloc);
    if (ty == nil) { ret err[doc.Accessor, str]("out of memory reading accessor type"); }
    val tr: Result[doc.AccessorType, str] = accessor_type(ty);
    if (is_err[doc.AccessorType, str](tr)) { ret err[doc.Accessor, str](unwrap_err[doc.AccessorType, str](tr)); }
    a.element_type = unwrap_ok[doc.AccessorType, str](tr);

    val min_m: *json.Value = json.value_find(e, "min");
    if (min_m != nil && json.value_is_array(min_m)) {
        a.bounds_len = read_floats(min_m, ?a.min[0], doc.MAX_COMPONENTS);
        a.has_min = true;
    }
    val max_m: *json.Value = json.value_find(e, "max");
    if (max_m != nil && json.value_is_array(max_m)) {
        val ml: usize = read_floats(max_m, ?a.max[0], doc.MAX_COMPONENTS);
        if (ml > a.bounds_len) { a.bounds_len = ml; }
        a.has_max = true;
    }
    ret ok[doc.Accessor, str](a);
}

# read an attribute-map object into a Slice[Attribute]
fun parse_attributes(obj: *json.Value, alloc: *allo.Allocator) Result[slice.Slice[doc.Attribute], str] {
    if (obj == nil || !json.value_is_object(obj)) { ret ok[slice.Slice[doc.Attribute], str](slice.make[doc.Attribute](nil, 0)); }
    val n: usize = json.value_count(obj);
    if (n == 0) { ret ok[slice.Slice[doc.Attribute], str](slice.make[doc.Attribute](nil, 0)); }

    val ar: Result[*doc.Attribute, str] = allo.allocate[doc.Attribute](alloc, n);
    if (is_err[*doc.Attribute, str](ar)) { ret err[slice.Slice[doc.Attribute], str](unwrap_err[*doc.Attribute, str](ar)); }
    val data: *doc.Attribute = unwrap_ok[*doc.Attribute, str](ar);

    var i: usize = 0;
    for (i < n) {
        var at: doc.Attribute;
        at.name = key_own(obj, i, alloc);
        if (at.name == nil) { ret err[slice.Slice[doc.Attribute], str]("out of memory reading attribute name"); }
        val cv: *json.Value = json.value_get(obj, i);
        if (cv != nil && json.value_is_number(cv)) {
            at.accessor = json.value_number(cv);
        } or {
            at.accessor = doc.NONE;
        }
        data[i] = at;
        i = i + 1;
    }
    ret ok[slice.Slice[doc.Attribute], str](slice.make[doc.Attribute](data, n));
}

# read a primitive's morph target array
fun parse_morph_targets(prim: *json.Value, alloc: *allo.Allocator) Result[slice.Slice[doc.MorphTarget], str] {
    val arr: *json.Value = json.value_find(prim, "targets");
    if (arr == nil || !json.value_is_array(arr)) { ret ok[slice.Slice[doc.MorphTarget], str](slice.make[doc.MorphTarget](nil, 0)); }
    val n: usize = json.value_count(arr);
    if (n == 0) { ret ok[slice.Slice[doc.MorphTarget], str](slice.make[doc.MorphTarget](nil, 0)); }

    val ar: Result[*doc.MorphTarget, str] = allo.allocate[doc.MorphTarget](alloc, n);
    if (is_err[*doc.MorphTarget, str](ar)) { ret err[slice.Slice[doc.MorphTarget], str](unwrap_err[*doc.MorphTarget, str](ar)); }
    val data: *doc.MorphTarget = unwrap_ok[*doc.MorphTarget, str](ar);

    var i: usize = 0;
    for (i < n) {
        val tr: Result[slice.Slice[doc.Attribute], str] = parse_attributes(json.value_get(arr, i), alloc);
        if (is_err[slice.Slice[doc.Attribute], str](tr)) { ret err[slice.Slice[doc.MorphTarget], str](unwrap_err[slice.Slice[doc.Attribute], str](tr)); }
        var t: doc.MorphTarget;
        t.attributes = unwrap_ok[slice.Slice[doc.Attribute], str](tr);
        data[i] = t;
        i = i + 1;
    }
    ret ok[slice.Slice[doc.MorphTarget], str](slice.make[doc.MorphTarget](data, n));
}

# read one mesh primitive
fun parse_primitive(e: *json.Value, alloc: *allo.Allocator) Result[doc.Primitive, str] {
    var p: doc.Primitive;
    p.indices = get_index(e, "indices");
    p.material = get_index(e, "material");
    p.mode = get_i64(e, "mode", doc.MODE_TRIANGLES::i64)::doc.PrimitiveMode;

    val atr: Result[slice.Slice[doc.Attribute], str] = parse_attributes(json.value_find(e, "attributes"), alloc);
    if (is_err[slice.Slice[doc.Attribute], str](atr)) { ret err[doc.Primitive, str](unwrap_err[slice.Slice[doc.Attribute], str](atr)); }
    p.attributes = unwrap_ok[slice.Slice[doc.Attribute], str](atr);

    val mtr: Result[slice.Slice[doc.MorphTarget], str] = parse_morph_targets(e, alloc);
    if (is_err[slice.Slice[doc.MorphTarget], str](mtr)) { ret err[doc.Primitive, str](unwrap_err[slice.Slice[doc.MorphTarget], str](mtr)); }
    p.targets = unwrap_ok[slice.Slice[doc.MorphTarget], str](mtr);
    ret ok[doc.Primitive, str](p);
}

# read one mesh and its primitives
fun parse_mesh(e: *json.Value, alloc: *allo.Allocator) Result[doc.Mesh, str] {
    var m: doc.Mesh;
    m.name = get_str(e, "name", alloc);
    if (m.name == nil) { ret err[doc.Mesh, str]("out of memory reading mesh name"); }

    val wr: Result[slice.Slice[f32], str] = parse_float_slice(e, "weights", alloc);
    if (is_err[slice.Slice[f32], str](wr)) { ret err[doc.Mesh, str](unwrap_err[slice.Slice[f32], str](wr)); }
    m.weights = unwrap_ok[slice.Slice[f32], str](wr);

    val arr: *json.Value = json.value_find(e, "primitives");
    if (arr == nil || !json.value_is_array(arr)) {
        m.primitives = slice.make[doc.Primitive](nil, 0);
        ret ok[doc.Mesh, str](m);
    }
    val n: usize = json.value_count(arr);
    if (n == 0) {
        m.primitives = slice.make[doc.Primitive](nil, 0);
        ret ok[doc.Mesh, str](m);
    }

    val ar: Result[*doc.Primitive, str] = allo.allocate[doc.Primitive](alloc, n);
    if (is_err[*doc.Primitive, str](ar)) { ret err[doc.Mesh, str](unwrap_err[*doc.Primitive, str](ar)); }
    val data: *doc.Primitive = unwrap_ok[*doc.Primitive, str](ar);

    var i: usize = 0;
    for (i < n) {
        val pr: Result[doc.Primitive, str] = parse_primitive(json.value_get(arr, i), alloc);
        if (is_err[doc.Primitive, str](pr)) { ret err[doc.Mesh, str](unwrap_err[doc.Primitive, str](pr)); }
        data[i] = unwrap_ok[doc.Primitive, str](pr);
        i = i + 1;
    }
    m.primitives = slice.make[doc.Primitive](data, n);
    ret ok[doc.Mesh, str](m);
}

# read one scene-graph node
fun parse_node(e: *json.Value, alloc: *allo.Allocator) Result[doc.Node, str] {
    var nd: doc.Node;
    nd.mesh = get_index(e, "mesh");
    nd.skin = get_index(e, "skin");
    nd.camera = get_index(e, "camera");
    nd.name = get_str(e, "name", alloc);
    if (nd.name == nil) { ret err[doc.Node, str]("out of memory reading node name"); }

    nd.translation[0] = 0.0f32; nd.translation[1] = 0.0f32; nd.translation[2] = 0.0f32;
    nd.rotation[0] = 0.0f32; nd.rotation[1] = 0.0f32; nd.rotation[2] = 0.0f32; nd.rotation[3] = 1.0f32;
    nd.scale[0] = 1.0f32; nd.scale[1] = 1.0f32; nd.scale[2] = 1.0f32;

    val mat_m: *json.Value = json.value_find(e, "matrix");
    if (mat_m != nil && json.value_is_array(mat_m)) {
        read_floats(mat_m, ?nd.matrix[0], 16);
        nd.has_matrix = true;
    } or {
        nd.has_matrix = false;
    }
    read_float_member(e, "translation", ?nd.translation[0], 3);
    read_float_member(e, "rotation", ?nd.rotation[0], 4);
    read_float_member(e, "scale", ?nd.scale[0], 3);

    val cr: Result[slice.Slice[i64], str] = parse_index_slice(e, "children", alloc);
    if (is_err[slice.Slice[i64], str](cr)) { ret err[doc.Node, str](unwrap_err[slice.Slice[i64], str](cr)); }
    nd.children = unwrap_ok[slice.Slice[i64], str](cr);

    val wr: Result[slice.Slice[f32], str] = parse_float_slice(e, "weights", alloc);
    if (is_err[slice.Slice[f32], str](wr)) { ret err[doc.Node, str](unwrap_err[slice.Slice[f32], str](wr)); }
    nd.weights = unwrap_ok[slice.Slice[f32], str](wr);
    ret ok[doc.Node, str](nd);
}

# read one scene
fun parse_scene(e: *json.Value, alloc: *allo.Allocator) Result[doc.Scene, str] {
    var s: doc.Scene;
    s.name = get_str(e, "name", alloc);
    if (s.name == nil) { ret err[doc.Scene, str]("out of memory reading scene name"); }
    val nr: Result[slice.Slice[i64], str] = parse_index_slice(e, "nodes", alloc);
    if (is_err[slice.Slice[i64], str](nr)) { ret err[doc.Scene, str](unwrap_err[slice.Slice[i64], str](nr)); }
    s.nodes = unwrap_ok[slice.Slice[i64], str](nr);
    ret ok[doc.Scene, str](s);
}

# read a material's metallic-roughness parameters
fun parse_pbr(mat: *json.Value) doc.PbrMetallicRoughness {
    var p: doc.PbrMetallicRoughness;
    p.base_color_factor[0] = 1.0f32; p.base_color_factor[1] = 1.0f32;
    p.base_color_factor[2] = 1.0f32; p.base_color_factor[3] = 1.0f32;
    p.metallic_factor = 1.0f32;
    p.roughness_factor = 1.0f32;
    p.base_color_texture.index = doc.NONE;
    p.base_color_texture.tex_coord = 0;
    p.metallic_roughness_texture.index = doc.NONE;
    p.metallic_roughness_texture.tex_coord = 0;

    val m: *json.Value = json.value_find(mat, "pbrMetallicRoughness");
    if (m == nil || !json.value_is_object(m)) { ret p; }
    read_float_member(m, "baseColorFactor", ?p.base_color_factor[0], 4);
    p.metallic_factor = get_f32(m, "metallicFactor", 1.0f32);
    p.roughness_factor = get_f32(m, "roughnessFactor", 1.0f32);
    p.base_color_texture = parse_texture_ref(m, "baseColorTexture");
    p.metallic_roughness_texture = parse_texture_ref(m, "metallicRoughnessTexture");
    ret p;
}

# map a glTF alpha mode string to an AlphaMode, default OPAQUE
fun alpha_mode(v: str) doc.AlphaMode {
    if (str_equals(v, "MASK"))  { ret doc.ALPHA_MASK; }
    if (str_equals(v, "BLEND")) { ret doc.ALPHA_BLEND; }
    ret doc.ALPHA_OPAQUE;
}

# read one material
fun parse_material(e: *json.Value, alloc: *allo.Allocator) Result[doc.Material, str] {
    var mt: doc.Material;
    mt.pbr = parse_pbr(e);
    mt.normal_texture = parse_texture_ref(e, "normalTexture");
    mt.occlusion_texture = parse_texture_ref(e, "occlusionTexture");
    mt.emissive_texture = parse_texture_ref(e, "emissiveTexture");
    mt.normal_scale = 1.0f32;
    mt.occlusion_strength = 1.0f32;
    mt.emissive_factor[0] = 0.0f32; mt.emissive_factor[1] = 0.0f32; mt.emissive_factor[2] = 0.0f32;
    mt.alpha_cutoff = get_f32(e, "alphaCutoff", 0.5f32);
    mt.double_sided = get_bool(e, "doubleSided", false);
    val am: str = get_str(e, "alphaMode", alloc);
    mt.name = get_str(e, "name", alloc);
    if (am == nil || mt.name == nil) { ret err[doc.Material, str]("out of memory reading material strings"); }
    mt.alpha_mode = alpha_mode(am);

    val nt: *json.Value = json.value_find(e, "normalTexture");
    if (nt != nil && json.value_is_object(nt)) { mt.normal_scale = get_f32(nt, "scale", 1.0f32); }
    val ot: *json.Value = json.value_find(e, "occlusionTexture");
    if (ot != nil && json.value_is_object(ot)) { mt.occlusion_strength = get_f32(ot, "strength", 1.0f32); }
    read_float_member(e, "emissiveFactor", ?mt.emissive_factor[0], 3);
    ret ok[doc.Material, str](mt);
}

# read one texture
fun parse_texture(e: *json.Value, alloc: *allo.Allocator) Result[doc.Texture, str] {
    var t: doc.Texture;
    t.source = get_index(e, "source");
    t.sampler = get_index(e, "sampler");
    t.name = get_str(e, "name", alloc);
    if (t.name == nil) { ret err[doc.Texture, str]("out of memory reading texture name"); }
    ret ok[doc.Texture, str](t);
}

# read one image
fun parse_image(e: *json.Value, alloc: *allo.Allocator) Result[doc.Image, str] {
    var im: doc.Image;
    im.uri         = get_str(e, "uri",      alloc);
    im.mime_type   = get_str(e, "mimeType", alloc);
    im.buffer_view = get_index(e, "bufferView");
    im.name        = get_str(e, "name",     alloc);
    if (im.uri == nil || im.mime_type == nil || im.name == nil) {
        ret err[doc.Image, str]("out of memory reading image strings");
    }
    ret ok[doc.Image, str](im);
}

# read one sampler
fun parse_sampler(e: *json.Value, alloc: *allo.Allocator) Result[doc.Sampler, str] {
    var sm: doc.Sampler;
    sm.mag_filter = get_index(e, "magFilter");
    sm.min_filter = get_index(e, "minFilter");
    sm.wrap_s = get_i64(e, "wrapS", 10497);
    sm.wrap_t = get_i64(e, "wrapT", 10497);
    sm.name = get_str(e, "name", alloc);
    if (sm.name == nil) { ret err[doc.Sampler, str]("out of memory reading sampler name"); }
    ret ok[doc.Sampler, str](sm);
}

# read one skin
fun parse_skin(e: *json.Value, alloc: *allo.Allocator) Result[doc.Skin, str] {
    var sk: doc.Skin;
    sk.inverse_bind_matrices = get_index(e, "inverseBindMatrices");
    sk.skeleton = get_index(e, "skeleton");
    sk.name = get_str(e, "name", alloc);
    if (sk.name == nil) { ret err[doc.Skin, str]("out of memory reading skin name"); }
    val jr: Result[slice.Slice[i64], str] = parse_index_slice(e, "joints", alloc);
    if (is_err[slice.Slice[i64], str](jr)) { ret err[doc.Skin, str](unwrap_err[slice.Slice[i64], str](jr)); }
    sk.joints = unwrap_ok[slice.Slice[i64], str](jr);
    ret ok[doc.Skin, str](sk);
}

# map a glTF interpolation string to an Interpolation, default LINEAR
fun interpolation(v: str) doc.Interpolation {
    if (str_equals(v, "STEP"))        { ret doc.INTERP_STEP; }
    if (str_equals(v, "CUBICSPLINE")) { ret doc.INTERP_CUBICSPLINE; }
    ret doc.INTERP_LINEAR;
}

# map a glTF channel target path string to a TargetPath, default TRANSLATION
fun target_path(v: str) doc.TargetPath {
    if (str_equals(v, "rotation")) { ret doc.PATH_ROTATION; }
    if (str_equals(v, "scale"))    { ret doc.PATH_SCALE; }
    if (str_equals(v, "weights"))  { ret doc.PATH_WEIGHTS; }
    ret doc.PATH_TRANSLATION;
}

# read an animation's sampler array
fun parse_anim_samplers(anim: *json.Value, alloc: *allo.Allocator) Result[slice.Slice[doc.AnimationSampler], str] {
    val arr: *json.Value = json.value_find(anim, "samplers");
    if (arr == nil || !json.value_is_array(arr)) { ret ok[slice.Slice[doc.AnimationSampler], str](slice.make[doc.AnimationSampler](nil, 0)); }
    val n: usize = json.value_count(arr);
    if (n == 0) { ret ok[slice.Slice[doc.AnimationSampler], str](slice.make[doc.AnimationSampler](nil, 0)); }

    val ar: Result[*doc.AnimationSampler, str] = allo.allocate[doc.AnimationSampler](alloc, n);
    if (is_err[*doc.AnimationSampler, str](ar)) { ret err[slice.Slice[doc.AnimationSampler], str](unwrap_err[*doc.AnimationSampler, str](ar)); }
    val data: *doc.AnimationSampler = unwrap_ok[*doc.AnimationSampler, str](ar);

    var i: usize = 0;
    for (i < n) {
        val e: *json.Value = json.value_get(arr, i);
        var s: doc.AnimationSampler;
        s.input = get_index(e, "input");
        s.output = get_index(e, "output");
        val ip: str = get_str(e, "interpolation", alloc);
        if (ip == nil) { ret err[slice.Slice[doc.AnimationSampler], str]("out of memory reading interpolation"); }
        s.interpolation = interpolation(ip);
        data[i] = s;
        i = i + 1;
    }
    ret ok[slice.Slice[doc.AnimationSampler], str](slice.make[doc.AnimationSampler](data, n));
}

# read an animation's channel array
fun parse_anim_channels(anim: *json.Value, alloc: *allo.Allocator) Result[slice.Slice[doc.AnimationChannel], str] {
    val arr: *json.Value = json.value_find(anim, "channels");
    if (arr == nil || !json.value_is_array(arr)) { ret ok[slice.Slice[doc.AnimationChannel], str](slice.make[doc.AnimationChannel](nil, 0)); }
    val n: usize = json.value_count(arr);
    if (n == 0) { ret ok[slice.Slice[doc.AnimationChannel], str](slice.make[doc.AnimationChannel](nil, 0)); }

    val ar: Result[*doc.AnimationChannel, str] = allo.allocate[doc.AnimationChannel](alloc, n);
    if (is_err[*doc.AnimationChannel, str](ar)) { ret err[slice.Slice[doc.AnimationChannel], str](unwrap_err[*doc.AnimationChannel, str](ar)); }
    val data: *doc.AnimationChannel = unwrap_ok[*doc.AnimationChannel, str](ar);

    var i: usize = 0;
    for (i < n) {
        val e: *json.Value = json.value_get(arr, i);
        var c: doc.AnimationChannel;
        c.sampler = get_index(e, "sampler");
        c.target_node = doc.NONE;
        c.target_path = doc.PATH_TRANSLATION;
        val tgt: *json.Value = json.value_find(e, "target");
        if (tgt != nil && json.value_is_object(tgt)) {
            c.target_node = get_index(tgt, "node");
            val tp: str = get_str(tgt, "path", alloc);
            if (tp == nil) { ret err[slice.Slice[doc.AnimationChannel], str]("out of memory reading target path"); }
            c.target_path = target_path(tp);
        }
        data[i] = c;
        i = i + 1;
    }
    ret ok[slice.Slice[doc.AnimationChannel], str](slice.make[doc.AnimationChannel](data, n));
}

# read one animation
fun parse_animation(e: *json.Value, alloc: *allo.Allocator) Result[doc.Animation, str] {
    var an: doc.Animation;
    an.name = get_str(e, "name", alloc);
    if (an.name == nil) { ret err[doc.Animation, str]("out of memory reading animation name"); }
    val sr: Result[slice.Slice[doc.AnimationSampler], str] = parse_anim_samplers(e, alloc);
    if (is_err[slice.Slice[doc.AnimationSampler], str](sr)) { ret err[doc.Animation, str](unwrap_err[slice.Slice[doc.AnimationSampler], str](sr)); }
    an.samplers = unwrap_ok[slice.Slice[doc.AnimationSampler], str](sr);
    val cr: Result[slice.Slice[doc.AnimationChannel], str] = parse_anim_channels(e, alloc);
    if (is_err[slice.Slice[doc.AnimationChannel], str](cr)) { ret err[doc.Animation, str](unwrap_err[slice.Slice[doc.AnimationChannel], str](cr)); }
    an.channels = unwrap_ok[slice.Slice[doc.AnimationChannel], str](cr);
    ret ok[doc.Animation, str](an);
}

# populate the buffer, buffer view, and accessor arrays
fun fill_buffers(root: *json.Value, d: *doc.Document, alloc: *allo.Allocator) Result[bool, str] {
    val ba: *json.Value = json.value_find(root, "buffers");
    if (ba != nil && json.value_is_array(ba)) {
        val n: usize = json.value_count(ba);
        if (n > 0) {
            val r: Result[*doc.Buffer, str] = allo.allocate[doc.Buffer](alloc, n);
            if (is_err[*doc.Buffer, str](r)) { ret err[bool, str](unwrap_err[*doc.Buffer, str](r)); }
            val data: *doc.Buffer = unwrap_ok[*doc.Buffer, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Buffer, str] = parse_buffer(json.value_get(ba, i), alloc);
                if (is_err[doc.Buffer, str](er)) { ret err[bool, str](unwrap_err[doc.Buffer, str](er)); }
                data[i] = unwrap_ok[doc.Buffer, str](er);
                i = i + 1;
            }
            d.buffers = slice.make[doc.Buffer](data, n);
        }
    }

    val va: *json.Value = json.value_find(root, "bufferViews");
    if (va != nil && json.value_is_array(va)) {
        val n: usize = json.value_count(va);
        if (n > 0) {
            val r: Result[*doc.BufferView, str] = allo.allocate[doc.BufferView](alloc, n);
            if (is_err[*doc.BufferView, str](r)) { ret err[bool, str](unwrap_err[*doc.BufferView, str](r)); }
            val data: *doc.BufferView = unwrap_ok[*doc.BufferView, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.BufferView, str] = parse_buffer_view(json.value_get(va, i), alloc);
                if (is_err[doc.BufferView, str](er)) { ret err[bool, str](unwrap_err[doc.BufferView, str](er)); }
                data[i] = unwrap_ok[doc.BufferView, str](er);
                i = i + 1;
            }
            d.buffer_views = slice.make[doc.BufferView](data, n);
        }
    }

    val aa: *json.Value = json.value_find(root, "accessors");
    if (aa != nil && json.value_is_array(aa)) {
        val n: usize = json.value_count(aa);
        if (n > 0) {
            val r: Result[*doc.Accessor, str] = allo.allocate[doc.Accessor](alloc, n);
            if (is_err[*doc.Accessor, str](r)) { ret err[bool, str](unwrap_err[*doc.Accessor, str](r)); }
            val data: *doc.Accessor = unwrap_ok[*doc.Accessor, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Accessor, str] = parse_accessor(json.value_get(aa, i), alloc);
                if (is_err[doc.Accessor, str](er)) { ret err[bool, str](unwrap_err[doc.Accessor, str](er)); }
                data[i] = unwrap_ok[doc.Accessor, str](er);
                i = i + 1;
            }
            d.accessors = slice.make[doc.Accessor](data, n);
        }
    }
    ret ok[bool, str](true);
}

# populate the scene-graph, mesh, material, and animation arrays
fun fill_arrays(root: *json.Value, d: *doc.Document, alloc: *allo.Allocator) Result[bool, str] {
    val sa: *json.Value = json.value_find(root, "scenes");
    if (sa != nil && json.value_is_array(sa)) {
        val n: usize = json.value_count(sa);
        if (n > 0) {
            val r: Result[*doc.Scene, str] = allo.allocate[doc.Scene](alloc, n);
            if (is_err[*doc.Scene, str](r)) { ret err[bool, str](unwrap_err[*doc.Scene, str](r)); }
            val data: *doc.Scene = unwrap_ok[*doc.Scene, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Scene, str] = parse_scene(json.value_get(sa, i), alloc);
                if (is_err[doc.Scene, str](er)) { ret err[bool, str](unwrap_err[doc.Scene, str](er)); }
                data[i] = unwrap_ok[doc.Scene, str](er);
                i = i + 1;
            }
            d.scenes = slice.make[doc.Scene](data, n);
        }
    }

    val na: *json.Value = json.value_find(root, "nodes");
    if (na != nil && json.value_is_array(na)) {
        val n: usize = json.value_count(na);
        if (n > 0) {
            val r: Result[*doc.Node, str] = allo.allocate[doc.Node](alloc, n);
            if (is_err[*doc.Node, str](r)) { ret err[bool, str](unwrap_err[*doc.Node, str](r)); }
            val data: *doc.Node = unwrap_ok[*doc.Node, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Node, str] = parse_node(json.value_get(na, i), alloc);
                if (is_err[doc.Node, str](er)) { ret err[bool, str](unwrap_err[doc.Node, str](er)); }
                data[i] = unwrap_ok[doc.Node, str](er);
                i = i + 1;
            }
            d.nodes = slice.make[doc.Node](data, n);
        }
    }

    val ma: *json.Value = json.value_find(root, "meshes");
    if (ma != nil && json.value_is_array(ma)) {
        val n: usize = json.value_count(ma);
        if (n > 0) {
            val r: Result[*doc.Mesh, str] = allo.allocate[doc.Mesh](alloc, n);
            if (is_err[*doc.Mesh, str](r)) { ret err[bool, str](unwrap_err[*doc.Mesh, str](r)); }
            val data: *doc.Mesh = unwrap_ok[*doc.Mesh, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Mesh, str] = parse_mesh(json.value_get(ma, i), alloc);
                if (is_err[doc.Mesh, str](er)) { ret err[bool, str](unwrap_err[doc.Mesh, str](er)); }
                data[i] = unwrap_ok[doc.Mesh, str](er);
                i = i + 1;
            }
            d.meshes = slice.make[doc.Mesh](data, n);
        }
    }

    val mta: *json.Value = json.value_find(root, "materials");
    if (mta != nil && json.value_is_array(mta)) {
        val n: usize = json.value_count(mta);
        if (n > 0) {
            val r: Result[*doc.Material, str] = allo.allocate[doc.Material](alloc, n);
            if (is_err[*doc.Material, str](r)) { ret err[bool, str](unwrap_err[*doc.Material, str](r)); }
            val data: *doc.Material = unwrap_ok[*doc.Material, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Material, str] = parse_material(json.value_get(mta, i), alloc);
                if (is_err[doc.Material, str](er)) { ret err[bool, str](unwrap_err[doc.Material, str](er)); }
                data[i] = unwrap_ok[doc.Material, str](er);
                i = i + 1;
            }
            d.materials = slice.make[doc.Material](data, n);
        }
    }

    val ta: *json.Value = json.value_find(root, "textures");
    if (ta != nil && json.value_is_array(ta)) {
        val n: usize = json.value_count(ta);
        if (n > 0) {
            val r: Result[*doc.Texture, str] = allo.allocate[doc.Texture](alloc, n);
            if (is_err[*doc.Texture, str](r)) { ret err[bool, str](unwrap_err[*doc.Texture, str](r)); }
            val data: *doc.Texture = unwrap_ok[*doc.Texture, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Texture, str] = parse_texture(json.value_get(ta, i), alloc);
                if (is_err[doc.Texture, str](er)) { ret err[bool, str](unwrap_err[doc.Texture, str](er)); }
                data[i] = unwrap_ok[doc.Texture, str](er);
                i = i + 1;
            }
            d.textures = slice.make[doc.Texture](data, n);
        }
    }

    val ia: *json.Value = json.value_find(root, "images");
    if (ia != nil && json.value_is_array(ia)) {
        val n: usize = json.value_count(ia);
        if (n > 0) {
            val r: Result[*doc.Image, str] = allo.allocate[doc.Image](alloc, n);
            if (is_err[*doc.Image, str](r)) { ret err[bool, str](unwrap_err[*doc.Image, str](r)); }
            val data: *doc.Image = unwrap_ok[*doc.Image, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Image, str] = parse_image(json.value_get(ia, i), alloc);
                if (is_err[doc.Image, str](er)) { ret err[bool, str](unwrap_err[doc.Image, str](er)); }
                data[i] = unwrap_ok[doc.Image, str](er);
                i = i + 1;
            }
            d.images = slice.make[doc.Image](data, n);
        }
    }

    val spa: *json.Value = json.value_find(root, "samplers");
    if (spa != nil && json.value_is_array(spa)) {
        val n: usize = json.value_count(spa);
        if (n > 0) {
            val r: Result[*doc.Sampler, str] = allo.allocate[doc.Sampler](alloc, n);
            if (is_err[*doc.Sampler, str](r)) { ret err[bool, str](unwrap_err[*doc.Sampler, str](r)); }
            val data: *doc.Sampler = unwrap_ok[*doc.Sampler, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Sampler, str] = parse_sampler(json.value_get(spa, i), alloc);
                if (is_err[doc.Sampler, str](er)) { ret err[bool, str](unwrap_err[doc.Sampler, str](er)); }
                data[i] = unwrap_ok[doc.Sampler, str](er);
                i = i + 1;
            }
            d.samplers = slice.make[doc.Sampler](data, n);
        }
    }

    val ka: *json.Value = json.value_find(root, "skins");
    if (ka != nil && json.value_is_array(ka)) {
        val n: usize = json.value_count(ka);
        if (n > 0) {
            val r: Result[*doc.Skin, str] = allo.allocate[doc.Skin](alloc, n);
            if (is_err[*doc.Skin, str](r)) { ret err[bool, str](unwrap_err[*doc.Skin, str](r)); }
            val data: *doc.Skin = unwrap_ok[*doc.Skin, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Skin, str] = parse_skin(json.value_get(ka, i), alloc);
                if (is_err[doc.Skin, str](er)) { ret err[bool, str](unwrap_err[doc.Skin, str](er)); }
                data[i] = unwrap_ok[doc.Skin, str](er);
                i = i + 1;
            }
            d.skins = slice.make[doc.Skin](data, n);
        }
    }

    val ana: *json.Value = json.value_find(root, "animations");
    if (ana != nil && json.value_is_array(ana)) {
        val n: usize = json.value_count(ana);
        if (n > 0) {
            val r: Result[*doc.Animation, str] = allo.allocate[doc.Animation](alloc, n);
            if (is_err[*doc.Animation, str](r)) { ret err[bool, str](unwrap_err[*doc.Animation, str](r)); }
            val data: *doc.Animation = unwrap_ok[*doc.Animation, str](r);
            var i: usize = 0;
            for (i < n) {
                val er: Result[doc.Animation, str] = parse_animation(json.value_get(ana, i), alloc);
                if (is_err[doc.Animation, str](er)) { ret err[bool, str](unwrap_err[doc.Animation, str](er)); }
                data[i] = unwrap_ok[doc.Animation, str](er);
                i = i + 1;
            }
            d.animations = slice.make[doc.Animation](data, n);
        }
    }
    ret ok[bool, str](true);
}

# parse a glTF JSON document into a Document
#
# json_bytes and the allocator must outlive the returned document: strings are
# borrowed from json_bytes and all arrays are allocated from alloc.
# ---
# json_bytes: the glTF JSON text
# len:        length of json_bytes in bytes
# alloc:      allocator for the document's arrays and the JSON value tree
# ret:        the parsed document, or an error
pub fun parse_document(json_bytes: *u8, len: usize, alloc: *allo.Allocator) Result[doc.Document, str] {
    val jr: Result[json.Value, str] = json.parse(json_bytes, len, alloc);
    if (is_err[json.Value, str](jr)) { ret err[doc.Document, str](unwrap_err[json.Value, str](jr)); }
    var root: json.Value = unwrap_ok[json.Value, str](jr);
    if (!json.value_is_object(?root)) { ret err[doc.Document, str]("glTF root is not an object"); }

    var d: doc.Document;
    val asr: Result[doc.Asset, str] = parse_asset(?root, alloc);
    if (is_err[doc.Asset, str](asr)) { ret err[doc.Document, str](unwrap_err[doc.Asset, str](asr)); }
    d.asset = unwrap_ok[doc.Asset, str](asr);
    d.scene = get_index(?root, "scene");

    val br: Result[bool, str] = fill_buffers(?root, ?d, alloc);
    if (is_err[bool, str](br)) { ret err[doc.Document, str](unwrap_err[bool, str](br)); }
    val ar: Result[bool, str] = fill_arrays(?root, ?d, alloc);
    if (is_err[bool, str](ar)) { ret err[doc.Document, str](unwrap_err[bool, str](ar)); }
    ret ok[doc.Document, str](d);
}

# parse a .glb container into a document plus its BIN buffer
# ---
# data:  the .glb bytes
# len:   length of data in bytes
# alloc: allocator for the document
# ret:   the document and BIN span, or an error
pub fun load_glb(data: *u8, len: usize, alloc: *allo.Allocator) Result[Loaded, str] {
    val gr: Result[glb.Glb, str] = glb.parse_glb(data, len);
    if (is_err[glb.Glb, str](gr)) { ret err[Loaded, str](unwrap_err[glb.Glb, str](gr)); }
    val g: glb.Glb = unwrap_ok[glb.Glb, str](gr);

    val dr: Result[doc.Document, str] = parse_document(g.json, g.json_len, alloc);
    if (is_err[doc.Document, str](dr)) { ret err[Loaded, str](unwrap_err[doc.Document, str](dr)); }

    var out: Loaded;
    out.document = unwrap_ok[doc.Document, str](dr);
    out.bin = g.bin;
    out.bin_len = g.bin_len;
    ret ok[Loaded, str](out);
}

# copy a null-terminated string into out at off, returning the new offset
fun append_cstr(out: *u8, off: usize, s: str) usize {
    var i: usize = 0;
    for (s[i] != 0) {
        out[off + i] = s[i];
        i = i + 1;
    }
    ret off + i;
}

# pack JSON bytes and BIN bytes into a .glb buffer
#
# the JSON chunk is space-padded and the BIN chunk zero-padded to 4-byte
# alignment, matching the container specification.
fun assemble_glb(out: *u8, json: *u8, json_len: usize, bin: *u8, bin_len: usize) usize {
    val jpad: usize = (4 - (json_len % 4)) % 4;
    val jchunk: usize = json_len + jpad;
    val bpad: usize = (4 - (bin_len % 4)) % 4;
    val bchunk: usize = bin_len + bpad;
    val total: usize = 12 + 8 + jchunk + 8 + bchunk;

    bytes.write_u32(out, 0, glb.MAGIC);
    bytes.write_u32(out, 4, glb.VERSION);
    bytes.write_u32(out, 8, total::u32);

    bytes.write_u32(out, 12, jchunk::u32);
    bytes.write_u32(out, 16, glb.CHUNK_JSON);
    var i: usize = 0;
    for (i < json_len) { out[20 + i] = json[i]; i = i + 1; }
    var p: usize = 0;
    for (p < jpad) { out[20 + json_len + p] = ' '; p = p + 1; }

    val boff: usize = 20 + jchunk;
    bytes.write_u32(out, boff, bchunk::u32);
    bytes.write_u32(out, boff + 4, glb.CHUNK_BIN);
    i = 0;
    for (i < bin_len) { out[boff + 8 + i] = bin[i]; i = i + 1; }
    p = 0;
    for (p < bpad) { out[boff + 8 + bin_len + p] = 0; p = p + 1; }
    ret total;
}

# build a glTF document exercising integer and float fields into dst
# ---
# dst: destination buffer for the JSON bytes
# ret: number of bytes written
fun fixture_json(dst: *u8) usize {
    var o: usize = 0;
    o = append_cstr(dst, o, "{\"asset\":{\"version\":\"2.0\",\"generator\":\"mach-gltf-test\"},");
    o = append_cstr(dst, o, "\"scene\":0,\"scenes\":[{\"nodes\":[0]}],");
    o = append_cstr(dst, o, "\"nodes\":[{\"name\":\"root\",\"mesh\":0,\"children\":[1],\"translation\":[1.5,-2.0,3.25],\"scale\":[2.0,2.0,2.0]},");
    o = append_cstr(dst, o, "{\"name\":\"child\",\"rotation\":[0.0,0.0,0.0,1.0]}],");
    o = append_cstr(dst, o, "\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1,\"material\":0,\"mode\":4}]}],");
    o = append_cstr(dst, o, "\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":3,\"type\":\"VEC3\",\"min\":[1.0,2.0,3.0],\"max\":[7.0,8.0,9.0]},");
    o = append_cstr(dst, o, "{\"bufferView\":1,\"componentType\":5123,\"count\":3,\"type\":\"SCALAR\"}],");
    o = append_cstr(dst, o, "\"bufferViews\":[{\"buffer\":0,\"byteOffset\":0,\"byteLength\":36},{\"buffer\":0,\"byteOffset\":36,\"byteLength\":6}],");
    o = append_cstr(dst, o, "\"buffers\":[{\"byteLength\":42}],");
    o = append_cstr(dst, o, "\"materials\":[{\"pbrMetallicRoughness\":{\"baseColorFactor\":[1.0,0.5,0.25,1.0],\"metallicFactor\":0.0,\"roughnessFactor\":0.5},");
    o = append_cstr(dst, o, "\"emissiveFactor\":[0.5,0.25,0.125],\"alphaMode\":\"MASK\",\"alphaCutoff\":0.25,\"doubleSided\":true}]}");
    ret o;
}

# three vec3 float positions (1..9) then three u16 indices (0,1,2)
fun fixture_bin(b: *u8) usize {
    bytes.write_f32(b, 0, 1.0f32);
    bytes.write_f32(b, 4, 2.0f32);
    bytes.write_f32(b, 8, 3.0f32);
    bytes.write_f32(b, 12, 4.0f32);
    bytes.write_f32(b, 16, 5.0f32);
    bytes.write_f32(b, 20, 6.0f32);
    bytes.write_f32(b, 24, 7.0f32);
    bytes.write_f32(b, 28, 8.0f32);
    bytes.write_f32(b, 32, 9.0f32);
    bytes.write_u16(b, 36, 0);
    bytes.write_u16(b, 38, 1);
    bytes.write_u16(b, 40, 2);
    ret 42;
}

test "parse: document structure from a synthetic .glb, including float fields" {
    var a: allo.Allocator;
    page.make(?a);

    var binsrc: [42]u8;
    fixture_bin(?binsrc[0]);
    var jbuf: [1024]u8;
    val jl: usize = fixture_json(?jbuf[0]);
    var buf: [2048]u8;
    val n: usize = assemble_glb(?buf[0], ?jbuf[0], jl, ?binsrc[0], 42);

    val lr: Result[Loaded, str] = load_glb(?buf[0], n, ?a);
    if (is_err[Loaded, str](lr)) { ret 1; }
    val ld: Loaded = unwrap_ok[Loaded, str](lr);
    val d: doc.Document = ld.document;

    if (!str_equals(d.asset.version, "2.0")) { ret 1; }
    if (d.scene != 0) { ret 1; }
    if (d.scenes.size != 1 || d.nodes.size != 2) { ret 1; }
    if (d.scenes.data[0].nodes.size != 1 || d.scenes.data[0].nodes.data[0] != 0) { ret 1; }

    val n0: *doc.Node = ?d.nodes.data[0];
    if (n0.mesh != 0) { ret 1; }
    if (n0.children.size != 1 || n0.children.data[0] != 1) { ret 1; }
    if (n0.has_matrix) { ret 1; }
    if (n0.translation[0] != 1.5f32 || n0.translation[1] != -2.0f32 || n0.translation[2] != 3.25f32) { ret 1; }
    if (n0.scale[0] != 2.0f32 || n0.scale[1] != 2.0f32 || n0.scale[2] != 2.0f32) { ret 1; }
    if (n0.rotation[3] != 1.0f32) { ret 1; }
    if (d.nodes.data[1].rotation[3] != 1.0f32) { ret 1; }

    if (d.meshes.size != 1) { ret 1; }
    val prim: *doc.Primitive = ?d.meshes.data[0].primitives.data[0];
    if (prim.attributes.size != 1) { ret 1; }
    if (!str_equals(prim.attributes.data[0].name, "POSITION")) { ret 1; }
    if (prim.attributes.data[0].accessor != 0) { ret 1; }
    if (prim.indices != 1 || prim.material != 0) { ret 1; }
    if (prim.mode != doc.MODE_TRIANGLES) { ret 1; }

    if (d.accessors.size != 2) { ret 1; }
    val ac0: *doc.Accessor = ?d.accessors.data[0];
    if (ac0.component_type != doc.COMPONENT_FLOAT || ac0.count != 3) { ret 1; }
    if (ac0.element_type != doc.TYPE_VEC3) { ret 1; }
    if (!ac0.has_min || !ac0.has_max || ac0.bounds_len != 3) { ret 1; }
    if (ac0.min[0] != 1.0f32 || ac0.min[2] != 3.0f32) { ret 1; }
    if (ac0.max[0] != 7.0f32 || ac0.max[2] != 9.0f32) { ret 1; }
    if (d.accessors.data[1].component_type != doc.COMPONENT_UNSIGNED_SHORT) { ret 1; }

    if (d.buffer_views.size != 2) { ret 1; }
    if (d.buffer_views.data[0].byte_length != 36) { ret 1; }
    if (d.buffer_views.data[1].byte_offset != 36) { ret 1; }
    if (d.buffers.size != 1 || d.buffers.data[0].byte_length != 42) { ret 1; }

    if (d.materials.size != 1) { ret 1; }
    val mt: *doc.Material = ?d.materials.data[0];
    if (mt.pbr.base_color_factor[1] != 0.5f32 || mt.pbr.base_color_factor[2] != 0.25f32) { ret 1; }
    if (mt.pbr.metallic_factor != 0.0f32 || mt.pbr.roughness_factor != 0.5f32) { ret 1; }
    if (mt.emissive_factor[0] != 0.5f32 || mt.emissive_factor[2] != 0.125f32) { ret 1; }
    if (mt.alpha_mode != doc.ALPHA_MASK || mt.alpha_cutoff != 0.25f32) { ret 1; }
    if (!mt.double_sided) { ret 1; }
    ret 0;
}

test "parse: accessor reads over the BIN chunk return exact values" {
    var a: allo.Allocator;
    page.make(?a);

    var binsrc: [42]u8;
    fixture_bin(?binsrc[0]);
    var jbuf: [1024]u8;
    val jl: usize = fixture_json(?jbuf[0]);
    var buf: [2048]u8;
    val n: usize = assemble_glb(?buf[0], ?jbuf[0], jl, ?binsrc[0], 42);

    val lr: Result[Loaded, str] = load_glb(?buf[0], n, ?a);
    if (is_err[Loaded, str](lr)) { ret 1; }
    var ld: Loaded = unwrap_ok[Loaded, str](lr);

    val pr: Result[accessor.Plan, str] = accessor.plan(?ld.document, ld.bin, ld.bin_len, 0);
    if (is_err[accessor.Plan, str](pr)) { ret 1; }
    var pos_plan: accessor.Plan = unwrap_ok[accessor.Plan, str](pr);

    var pos: [9]f32;
    val fr: Result[usize, str] = accessor.read_f32(?pos_plan, ?pos[0], 9);
    if (is_err[usize, str](fr)) { ret 1; }
    if (unwrap_ok[usize, str](fr) != 9) { ret 1; }
    var k: usize = 0;
    for (k < 9) {
        if (pos[k] != (k + 1)::f32) { ret 1; }
        k = k + 1;
    }

    val ir: Result[accessor.Plan, str] = accessor.plan(?ld.document, ld.bin, ld.bin_len, 1);
    if (is_err[accessor.Plan, str](ir)) { ret 1; }
    var idx_plan: accessor.Plan = unwrap_ok[accessor.Plan, str](ir);

    var idx: [3]u16;
    val ur: Result[usize, str] = accessor.read_u16(?idx_plan, ?idx[0], 3);
    if (is_err[usize, str](ur)) { ret 1; }
    if (idx[0] != 0 || idx[1] != 1 || idx[2] != 2) { ret 1; }
    ret 0;
}

test "parse: parse_document rejects a non-object root" {
    var a: allo.Allocator;
    page.make(?a);
    val src: str = "[1,2,3]";
    if (!is_err[doc.Document, str](parse_document(src::*u8, 7, ?a))) { ret 1; }
    ret 0;
}

# the point of owning the strings: a Document must survive the JSON bytes it
# came from. this scribbles over the whole source buffer after parsing and then
# reads the strings back. against borrowed views every one of these comparisons
# reads the scribble and fails, which is what makes this test worth having.
test "parse: the document outlives the JSON buffer it was parsed from" {
    var a: allo.Allocator;
    page.make(?a);

    var jbuf: [1024]u8;
    val jl: usize = fixture_json(?jbuf[0]);

    val dr: Result[doc.Document, str] = parse_document(?jbuf[0], jl, ?a);
    if (is_err[doc.Document, str](dr)) { ret 1; }
    val d: doc.Document = unwrap_ok[doc.Document, str](dr);

    # destroy the source. every byte, not just the terminators.
    var i: usize = 0;
    for (i < 1024) {
        jbuf[i] = 0xAA;
        i = i + 1;
    }

    if (!str_equals(d.asset.version, "2.0")) { ret 1; }
    if (!str_equals(d.asset.generator, "mach-gltf-test")) { ret 1; }
    # an absent member is an owned empty string, never nil, so this is safe to
    # compare rather than needing a nil guard first
    if (!str_equals(d.asset.copyright, "")) { ret 1; }
    ret 0;
}
