# the .glb binary container format
#
# a .glb file is a 12-byte header followed by length-prefixed chunks. the
# first chunk is always JSON (the glTF document); an optional second chunk
# (BIN) carries the binary buffer referenced by the document. this module
# defines the on-disk tags, the header layout, chunk iteration, and the
# container-level validation that turns an untrusted byte buffer into the
# JSON and BIN spans the rest of the loader consumes.

use gltf.bytes;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

# the container magic, the ASCII bytes "glTF" read little-endian
pub val MAGIC: u32 = 0x46546C67;

# the container version defined by glTF 2.0
pub val VERSION: u32 = 2;

# chunk type tag for the JSON document, ASCII "JSON"
pub val CHUNK_JSON: u32 = 0x4E4F534A;

# chunk type tag for the binary buffer, ASCII "BIN\0"
pub val CHUNK_BIN: u32 = 0x004E4942;

# byte length of the fixed .glb header
pub val HEADER_SIZE: usize = 12;

# byte length of a chunk's length+type prefix
pub val CHUNK_HEADER_SIZE: usize = 8;

# why a byte buffer is not a well-formed .glb container
# ---
# short:           the buffer is shorter than the 12-byte header; carries its length
# magic:           the header magic is not MAGIC; carries the magic found
# version:         the header version is not VERSION; carries the version found
# length:          the declared total length is smaller than the header or larger
#                  than the buffer; carries the declared length
# chunk_truncated: a chunk header runs past the declared length; carries its offset
# chunk_alignment: a chunk length is not a multiple of 4; carries the chunk's offset
# chunk_overrun:   a chunk's data runs past the declared length; carries its offset
# first_chunk:     the first chunk is not JSON; carries the chunk type found
# no_json:         the container holds no chunk at all
pub tag ContainerError: u8 {
    short:           usize;
    magic:           u32;
    version:         u32;
    length:          u32;
    chunk_truncated: usize;
    chunk_alignment: usize;
    chunk_overrun:   usize;
    first_chunk:     u32;
    no_json;
}

# the 12-byte .glb file header, matching the on-disk layout
# ---
# magic:   must equal MAGIC for a valid container
# version: container version, 2 for glTF 2.0
# length:  total file length in bytes, header included
pub rec Header {
    magic:   u32;
    version: u32;
    length:  u32;
}

# a single .glb chunk: its type tag and a borrowed view over its data
# ---
# kind: chunk type tag (CHUNK_JSON, CHUNK_BIN, or an unknown extension tag)
# data: pointer into the source buffer at the chunk's first data byte
# len:  chunk data length in bytes, excluding the 8-byte chunk header
pub rec Chunk {
    kind: u32;
    data: *u8;
    len:  usize;
}

# cursor for walking the chunk sequence after the header
# ---
# src: the source buffer
# end: authoritative end offset (the header's declared length)
# pos: current offset into src
pub rec ChunkIter {
    src: *u8;
    end: usize;
    pos: usize;
}

# the two spans a parsed container yields
# ---
# json:     pointer into the source at the JSON chunk's first byte
# json_len: JSON chunk length in bytes
# bin:      pointer to the BIN chunk's first byte, or nil when absent
# bin_len:  BIN chunk length in bytes, or 0 when absent
pub rec Glb {
    json:     *u8;
    json_len: usize;
    bin:      *u8;
    bin_len:  usize;
}

# report whether a header carries the glTF 2.0 container magic and version
pub fun is_valid(h: *Header) bool {
    ret h.magic == MAGIC && h.version == VERSION;
}

# read the 12-byte container header
# ---
# data: source buffer
# len:  source length in bytes
# ret:  the header, or short when the buffer cannot hold one
pub fun read_header(data: *u8, len: usize) res[Header, ContainerError] {
    if (len < HEADER_SIZE) { ret res[Header, ContainerError].err{ContainerError.short{len}}; }

    var h: Header;
    h.magic   = bytes.read_u32(data, 0);
    h.version = bytes.read_u32(data, 4);
    h.length  = bytes.read_u32(data, 8);
    ret res[Header, ContainerError].ok{h};
}

# begin walking chunks after validating the container header
#
# the declared header length is authoritative for the chunk region: it must
# fit within the supplied buffer, and every chunk is bounded by it. trailing
# bytes beyond the declared length are ignored.
# ---
# data: source buffer
# len:  source length in bytes
# ret:  an iterator positioned at the first chunk, or the header's defect
pub fun chunk_iter(data: *u8, len: usize) res[ChunkIter, ContainerError] {
    val hr: res[Header, ContainerError] = read_header(data, len);
    if (sel hr.err) { ret res[ChunkIter, ContainerError].err{hr.err}; }
    val h: Header = hr.ok;

    if (h.magic != MAGIC)     { ret res[ChunkIter, ContainerError].err{ContainerError.magic{h.magic}}; }
    if (h.version != VERSION) { ret res[ChunkIter, ContainerError].err{ContainerError.version{h.version}}; }

    val total: usize = h.length::usize;
    if (total < HEADER_SIZE || total > len) { ret res[ChunkIter, ContainerError].err{ContainerError.length{h.length}}; }

    var it: ChunkIter;
    it.src = data;
    it.end = total;
    it.pos = HEADER_SIZE;
    ret res[ChunkIter, ContainerError].ok{it};
}

# advance the iterator to the next chunk
#
# chunk data lengths are 4-byte aligned per the specification; a length that
# is not, or that runs past the container end, is rejected as malformed.
# ---
# it:  iterator to advance
# ret: the next chunk, none at the end of the chunk region, or the chunk's defect
pub fun chunk_next(it: *ChunkIter) res[opt[Chunk], ContainerError] {
    if (it.pos >= it.end) { ret res[opt[Chunk], ContainerError].ok{opt[Chunk].none{}}; }
    if (it.pos + CHUNK_HEADER_SIZE > it.end) {
        ret res[opt[Chunk], ContainerError].err{ContainerError.chunk_truncated{it.pos}};
    }

    val clen:  usize = bytes.read_u32(it.src, it.pos)::usize;
    val ckind: u32   = bytes.read_u32(it.src, it.pos + 4);
    if (clen % 4 != 0) { ret res[opt[Chunk], ContainerError].err{ContainerError.chunk_alignment{it.pos}}; }

    val dstart: usize = it.pos + CHUNK_HEADER_SIZE;
    if (clen > it.end - dstart) { ret res[opt[Chunk], ContainerError].err{ContainerError.chunk_overrun{it.pos}}; }

    var c: Chunk;
    c.kind = ckind;
    c.data = (it.src::usize + dstart)::*u8;
    c.len  = clen;
    it.pos = dstart + clen;
    ret res[opt[Chunk], ContainerError].ok{opt[Chunk].some{c}};
}

# validate a .glb buffer and extract its JSON and optional BIN spans
#
# the first chunk must be JSON; the first BIN chunk supplies the binary buffer.
# unknown chunk types are ignored, as the specification directs.
# ---
# data: source buffer
# len:  source length in bytes
# ret:  the JSON and BIN spans, or the container's first defect
pub fun parse_glb(data: *u8, len: usize) res[Glb, ContainerError] {
    val ir: res[ChunkIter, ContainerError] = chunk_iter(data, len);
    if (sel ir.err) { ret res[Glb, ContainerError].err{ir.err}; }
    var it: ChunkIter = ir.ok;

    var g: Glb;
    g.json     = nil;
    g.json_len = 0;
    g.bin      = nil;
    g.bin_len  = 0;

    var seen_json: bool = false;
    var seen_bin:  bool = false;

    for {
        val nr: res[opt[Chunk], ContainerError] = chunk_next(?it);
        if (sel nr.err)     { ret res[Glb, ContainerError].err{nr.err}; }
        if (sel nr.ok.none) { brk; }
        val c: Chunk = nr.ok.some;

        if (!seen_json) {
            if (c.kind != CHUNK_JSON) { ret res[Glb, ContainerError].err{ContainerError.first_chunk{c.kind}}; }
            g.json     = c.data;
            g.json_len = c.len;
            seen_json  = true;
            cnt;
        }

        if (c.kind == CHUNK_BIN && !seen_bin) {
            g.bin     = c.data;
            g.bin_len = c.len;
            seen_bin  = true;
        }
    }

    if (!seen_json) { ret res[Glb, ContainerError].err{ContainerError.no_json{}}; }
    ret res[Glb, ContainerError].ok{g};
}

test "glb: container magic and chunk tags match the specification" {
    if (MAGIC != 0x46546C67)      { ret 1; }
    if (VERSION != 2)             { ret 1; }
    if (CHUNK_JSON != 0x4E4F534A) { ret 1; }
    if (CHUNK_BIN != 0x004E4942)  { ret 1; }
    ret 0;
}

test "glb: is_valid accepts a well-formed header and rejects a bad magic" {
    var ok: Header;
    ok.magic   = MAGIC;
    ok.version = VERSION;
    ok.length  = 12;
    if (!is_valid(?ok)) { ret 1; }

    var bad: Header;
    bad.magic   = 0;
    bad.version = VERSION;
    bad.length  = 12;
    if (is_valid(?bad)) { ret 1; }
    ret 0;
}

# write a minimal JSON+BIN .glb into buf and return its length
#
# json data is "{}  " (space-padded to 4) and bin data is four known bytes.
fun build_container(buf: *u8) usize {
    bytes.write_u32(buf, 0, MAGIC);
    bytes.write_u32(buf, 4, VERSION);
    bytes.write_u32(buf, 8, 36);

    bytes.write_u32(buf, 12, 4);
    bytes.write_u32(buf, 16, CHUNK_JSON);
    buf[20] = '{';
    buf[21] = '}';
    buf[22] = ' ';
    buf[23] = ' ';

    bytes.write_u32(buf, 24, 4);
    bytes.write_u32(buf, 28, CHUNK_BIN);
    buf[32] = 0xDE;
    buf[33] = 0xAD;
    buf[34] = 0xBE;
    buf[35] = 0xEF;
    ret 36;
}

test "glb: parse_glb extracts the JSON and BIN spans" {
    var buf: [36]u8;
    val n:   usize = build_container(?buf[0]);

    val r: res[Glb, ContainerError] = parse_glb(?buf[0], n);
    if (sel r.err) { ret 1; }
    val g: Glb = r.ok;

    if (g.json_len != 4)                      { ret 1; }
    if (g.json[0] != '{' || g.json[1] != '}') { ret 1; }
    if (g.bin == nil)                         { ret 1; }
    if (g.bin_len != 4)                       { ret 1; }
    if (g.bin[0] != 0xDE || g.bin[3] != 0xEF) { ret 1; }
    ret 0;
}

test "glb: parse_glb yields nil BIN when only a JSON chunk is present" {
    var buf: [24]u8;
    bytes.write_u32(?buf[0], 0, MAGIC);
    bytes.write_u32(?buf[0], 4, VERSION);
    bytes.write_u32(?buf[0], 8, 24);
    bytes.write_u32(?buf[0], 12, 4);
    bytes.write_u32(?buf[0], 16, CHUNK_JSON);
    buf[20] = '{';
    buf[21] = '}';
    buf[22] = ' ';
    buf[23] = ' ';

    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 24);
    if (sel r.err) { ret 1; }
    val g: Glb = r.ok;
    if (g.json_len != 4) { ret 1; }
    if (g.bin != nil)    { ret 1; }
    if (g.bin_len != 0)  { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a bad magic" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 0, 0);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)         { ret 1; }
    if (!sel r.err.magic) { ret 1; }
    if (r.err.magic != 0) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a header length past the buffer" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 8, 64);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)           { ret 1; }
    if (!sel r.err.length)  { ret 1; }
    if (r.err.length != 64) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a misaligned chunk length" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 12, 3);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)                    { ret 1; }
    if (!sel r.err.chunk_alignment)  { ret 1; }
    if (r.err.chunk_alignment != 12) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a chunk running past the container" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 12, 64);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)                  { ret 1; }
    if (!sel r.err.chunk_overrun)  { ret 1; }
    if (r.err.chunk_overrun != 12) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a first chunk that is not JSON" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 16, CHUNK_BIN);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)                       { ret 1; }
    if (!sel r.err.first_chunk)         { ret 1; }
    if (r.err.first_chunk != CHUNK_BIN) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a buffer shorter than the header" {
    var buf: [8]u8;
    bytes.write_u32(?buf[0], 0, MAGIC);
    bytes.write_u32(?buf[0], 4, VERSION);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 8);
    if (sel r.ok)         { ret 1; }
    if (!sel r.err.short) { ret 1; }
    if (r.err.short != 8) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a bad version" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 4, 1);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 36);
    if (sel r.ok)           { ret 1; }
    if (!sel r.err.version) { ret 1; }
    if (r.err.version != 1) { ret 1; }
    ret 0;
}

test "glb: parse_glb rejects a container with no chunks" {
    var buf: [12]u8;
    bytes.write_u32(?buf[0], 0, MAGIC);
    bytes.write_u32(?buf[0], 4, VERSION);
    bytes.write_u32(?buf[0], 8, 12);
    val r: res[Glb, ContainerError] = parse_glb(?buf[0], 12);
    if (sel r.ok)           { ret 1; }
    if (!sel r.err.no_json) { ret 1; }
    ret 0;
}

test "glb: chunk_next reports a truncated chunk header" {
    var buf: [36]u8;
    build_container(?buf[0]);
    bytes.write_u32(?buf[0], 8, 28);
    val ir: res[ChunkIter, ContainerError] = chunk_iter(?buf[0], 36);
    if (sel ir.err) { ret 1; }
    var it:    ChunkIter                       = ir.ok;
    val first: res[opt[Chunk], ContainerError] = chunk_next(?it);
    if (sel first.err)      { ret 1; }
    if (!sel first.ok.some) { ret 1; }
    val second: res[opt[Chunk], ContainerError] = chunk_next(?it);
    if (sel second.ok)                    { ret 1; }
    if (!sel second.err.chunk_truncated)  { ret 1; }
    if (second.err.chunk_truncated != 24) { ret 1; }
    ret 0;
}
