# little-endian scalar reads from an untrusted byte buffer
#
# glTF containers and buffer data are little-endian, and every target the
# loader builds for is little-endian; these helpers assemble scalars byte by
# byte so an unaligned offset into a caller buffer is always safe. bounds are
# the caller's responsibility; the reads are the innermost primitive.

use std.types.size.usize;

# read a little-endian u16 at byte offset off
pub fun read_u16(p: *u8, off: usize) u16 {
    ret (p[off]::u16) | (p[off + 1]::u16 << 8);
}

# read a little-endian u32 at byte offset off
pub fun read_u32(p: *u8, off: usize) u32 {
    ret (p[off]::u32)
      | (p[off + 1]::u32 << 8)
      | (p[off + 2]::u32 << 16)
      | (p[off + 3]::u32 << 24);
}

# read a little-endian signed 16-bit integer at byte offset off
pub fun read_i16(p: *u8, off: usize) i16 {
    ret read_u16(p, off):~i16;
}

# read a little-endian IEEE-754 single-precision float at byte offset off
pub fun read_f32(p: *u8, off: usize) f32 {
    ret read_u32(p, off):~f32;
}

# store v as a little-endian u16 at byte offset off
pub fun write_u16(p: *u8, off: usize, v: u16) {
    p[off]     = (v & 0xFF)::u8;
    p[off + 1] = ((v >> 8) & 0xFF)::u8;
}

# store v as a little-endian u32 at byte offset off
pub fun write_u32(p: *u8, off: usize, v: u32) {
    p[off]     = (v & 0xFF)::u8;
    p[off + 1] = ((v >> 8) & 0xFF)::u8;
    p[off + 2] = ((v >> 16) & 0xFF)::u8;
    p[off + 3] = ((v >> 24) & 0xFF)::u8;
}

# store f as a little-endian IEEE-754 single-precision float at byte offset off
pub fun write_f32(p: *u8, off: usize, f: f32) {
    write_u32(p, off, f:~u32);
}

test "bytes: read_u16 assembles little-endian order" {
    var b: [2]u8 = [2]u8{0x34, 0x12};
    if (read_u16(?b[0], 0) != 0x1234) { ret 1; }
    ret 0;
}

test "bytes: read_u32 assembles little-endian order" {
    var b: [4]u8 = [4]u8{0x78, 0x56, 0x34, 0x12};
    if (read_u32(?b[0], 0) != 0x12345678) { ret 1; }
    ret 0;
}

test "bytes: read_f32 reinterprets the exact bit pattern" {
    # 1.0f32 is 0x3F800000 little-endian.
    var b: [4]u8 = [4]u8{0x00, 0x00, 0x80, 0x3F};
    val f: f32 = read_f32(?b[0], 0);
    if (f != 1.0f32) { ret 1; }
    ret 0;
}
