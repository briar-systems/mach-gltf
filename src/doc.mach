# gltf.doc: the in-memory glTF 2.0 document model.
#
# typed records mirroring the glTF top-level arrays and their cross-references.
# indices between arrays are stored as i64 with NONE marking an absent optional
# reference; names and other strings are borrowed StrViews into the source JSON,
# so the caller must keep that buffer alive while the document is in use. this
# module is pure data plus the small numeric helpers that describe accessor
# element layout; the JSON bridge lives in gltf.parse.

use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.StrView;
use slice: std.collections.slice;

# NONE: sentinel for an absent optional index (glTF indices are non-negative).
pub val NONE: i64 = -1;

# ComponentType: glTF accessor component type (an OpenGL scalar type enum).
pub def ComponentType: u32;
pub val COMPONENT_BYTE:           ComponentType = 5120;
pub val COMPONENT_UNSIGNED_BYTE:  ComponentType = 5121;
pub val COMPONENT_SHORT:          ComponentType = 5122;
pub val COMPONENT_UNSIGNED_SHORT: ComponentType = 5123;
pub val COMPONENT_UNSIGNED_INT:   ComponentType = 5125;
pub val COMPONENT_FLOAT:          ComponentType = 5126;

# AccessorType: glTF accessor element shape (SCALAR through MAT4).
pub def AccessorType: u8;
pub val TYPE_SCALAR: AccessorType = 0;
pub val TYPE_VEC2:   AccessorType = 1;
pub val TYPE_VEC3:   AccessorType = 2;
pub val TYPE_VEC4:   AccessorType = 3;
pub val TYPE_MAT2:   AccessorType = 4;
pub val TYPE_MAT3:   AccessorType = 5;
pub val TYPE_MAT4:   AccessorType = 6;

# PrimitiveMode: glTF primitive topology (an OpenGL draw-mode enum).
pub def PrimitiveMode: u32;
pub val MODE_POINTS:         PrimitiveMode = 0;
pub val MODE_LINES:          PrimitiveMode = 1;
pub val MODE_LINE_LOOP:      PrimitiveMode = 2;
pub val MODE_LINE_STRIP:     PrimitiveMode = 3;
pub val MODE_TRIANGLES:      PrimitiveMode = 4;
pub val MODE_TRIANGLE_STRIP: PrimitiveMode = 5;
pub val MODE_TRIANGLE_FAN:   PrimitiveMode = 6;

# Interpolation: animation sampler interpolation mode.
pub def Interpolation: u8;
pub val INTERP_LINEAR:      Interpolation = 0;
pub val INTERP_STEP:        Interpolation = 1;
pub val INTERP_CUBICSPLINE: Interpolation = 2;

# TargetPath: the node property an animation channel drives.
pub def TargetPath: u8;
pub val PATH_TRANSLATION: TargetPath = 0;
pub val PATH_ROTATION:    TargetPath = 1;
pub val PATH_SCALE:       TargetPath = 2;
pub val PATH_WEIGHTS:     TargetPath = 3;

# AlphaMode: material alpha interpretation.
pub def AlphaMode: u8;
pub val ALPHA_OPAQUE: AlphaMode = 0;
pub val ALPHA_MASK:   AlphaMode = 1;
pub val ALPHA_BLEND:  AlphaMode = 2;

# MAX_COMPONENTS: the largest accessor element (MAT4) has 16 components.
pub val MAX_COMPONENTS: usize = 16;

# component_count: number of scalar components in an accessor element type.
# ---
# ret: 1..16 for a known type, 0 for an unrecognized value
pub fun component_count(t: AccessorType) usize {
    if (t == TYPE_SCALAR) { ret 1; }
    if (t == TYPE_VEC2)   { ret 2; }
    if (t == TYPE_VEC3)   { ret 3; }
    if (t == TYPE_VEC4)   { ret 4; }
    if (t == TYPE_MAT2)   { ret 4; }
    if (t == TYPE_MAT3)   { ret 9; }
    if (t == TYPE_MAT4)   { ret 16; }
    ret 0;
}

# component_size: byte width of a single accessor component.
# ---
# ret: 1, 2, or 4 for a known component type, 0 for an unrecognized value
pub fun component_size(c: ComponentType) usize {
    if (c == COMPONENT_BYTE)           { ret 1; }
    if (c == COMPONENT_UNSIGNED_BYTE)  { ret 1; }
    if (c == COMPONENT_SHORT)          { ret 2; }
    if (c == COMPONENT_UNSIGNED_SHORT) { ret 2; }
    if (c == COMPONENT_UNSIGNED_INT)   { ret 4; }
    if (c == COMPONENT_FLOAT)          { ret 4; }
    ret 0;
}

# Asset: document metadata from the required top-level `asset` object.
# ---
# version:     glTF version string (e.g. "2.0")
# min_version: minimum version a client must support, empty when absent
# generator:   tool that produced the asset, empty when absent
# copyright:   copyright notice, empty when absent
pub rec Asset {
    version:     StrView;
    min_version: StrView;
    generator:   StrView;
    copyright:   StrView;
}

# Buffer: a block of binary data referenced by buffer views.
# ---
# byte_length: length of the buffer in bytes
# uri:         source URI, empty for the GLB BIN buffer (index 0)
# name:        user-defined name, empty when absent
pub rec Buffer {
    byte_length: usize;
    uri:         StrView;
    name:        StrView;
}

# BufferView: a typed window into a buffer.
# ---
# buffer:      index of the source buffer
# byte_offset: start offset into the buffer
# byte_length: length of the view in bytes
# byte_stride: element stride, 0 when tightly packed (unspecified)
# target:      intended GPU target (34962/34963), or NONE
# name:        user-defined name, empty when absent
pub rec BufferView {
    buffer:      i64;
    byte_offset: usize;
    byte_length: usize;
    byte_stride: usize;
    target:      i64;
    name:        StrView;
}

# Accessor: a typed view over a buffer view's bytes as element data.
# ---
# buffer_view:    index of the source buffer view, or NONE
# byte_offset:    start offset relative to the buffer view
# component_type: scalar component type
# normalized:     whether integer components map to a normalized float range
# count:          number of elements
# element_type:   element shape (SCALAR..MAT4)
# min:            per-component minimum bounds, valid up to bounds_len
# max:            per-component maximum bounds, valid up to bounds_len
# bounds_len:     number of valid min/max components, 0 when bounds are absent
# has_min:        whether the accessor declared minimum bounds
# has_max:        whether the accessor declared maximum bounds
# name:           user-defined name, empty when absent
pub rec Accessor {
    buffer_view:    i64;
    byte_offset:    usize;
    component_type: ComponentType;
    normalized:     bool;
    count:          usize;
    element_type:   AccessorType;
    min:            [16]f32;
    max:            [16]f32;
    bounds_len:     usize;
    has_min:        bool;
    has_max:        bool;
    name:           StrView;
}

# element_size: byte size of one accessor element (component_count * component_size).
# ---
# ret: element size in bytes, or 0 when the accessor's type or component is unrecognized
pub fun element_size(a: *Accessor) usize {
    ret component_count(a.element_type) * component_size(a.component_type);
}

# scalar_count: total number of scalar components an accessor yields (count * component_count).
#
# the size a reader's output buffer must have to hold the accessor's data.
pub fun scalar_count(a: *Accessor) usize {
    ret a.count * component_count(a.element_type);
}

# Attribute: one vertex attribute binding, a semantic name to an accessor index.
# ---
# name:     attribute semantic (e.g. "POSITION", "NORMAL", "TEXCOORD_0")
# accessor: index of the accessor supplying the attribute's data
pub rec Attribute {
    name:     StrView;
    accessor: i64;
}

# MorphTarget: a primitive morph target, its own set of attribute bindings.
# ---
# attributes: the target's displaced attributes (POSITION, NORMAL, TANGENT)
pub rec MorphTarget {
    attributes: slice.Slice[Attribute];
}

# Primitive: one drawable unit of a mesh.
# ---
# attributes: vertex attribute bindings
# targets:    morph targets, empty when absent
# indices:    accessor index for element indices, or NONE for non-indexed
# material:   material index, or NONE for the default material
# mode:       primitive topology
pub rec Primitive {
    attributes: slice.Slice[Attribute];
    targets:    slice.Slice[MorphTarget];
    indices:    i64;
    material:   i64;
    mode:       PrimitiveMode;
}

# Mesh: a set of primitives sharing a node's transform.
# ---
# primitives: the mesh's drawable primitives
# weights:    default morph target weights, empty when absent
# name:       user-defined name, empty when absent
pub rec Mesh {
    primitives: slice.Slice[Primitive];
    weights:    slice.Slice[f32];
    name:       StrView;
}

# Node: a scene-graph node with a local transform and optional attachments.
# ---
# children:    indices of child nodes
# mesh:        attached mesh index, or NONE
# skin:        attached skin index, or NONE
# camera:      attached camera index, or NONE
# has_matrix:  whether a matrix transform was given (otherwise use TRS)
# matrix:      column-major local transform, valid when has_matrix
# translation: TRS translation, spec default (0,0,0)
# rotation:    TRS rotation quaternion (x,y,z,w), spec default (0,0,0,1)
# scale:       TRS scale, spec default (1,1,1)
# weights:     morph target weights override, empty when absent
# name:        user-defined name, empty when absent
pub rec Node {
    children:    slice.Slice[i64];
    mesh:        i64;
    skin:        i64;
    camera:      i64;
    has_matrix:  bool;
    matrix:      [16]f32;
    translation: [3]f32;
    rotation:    [4]f32;
    scale:       [3]f32;
    weights:     slice.Slice[f32];
    name:        StrView;
}

# Scene: a set of root nodes to instantiate together.
# ---
# nodes: indices of the scene's root nodes
# name:  user-defined name, empty when absent
pub rec Scene {
    nodes: slice.Slice[i64];
    name:  StrView;
}

# TextureRef: a material's reference to a texture and its UV set.
# ---
# index:     texture index, or NONE when the reference is absent
# tex_coord: TEXCOORD attribute set index, spec default 0
pub rec TextureRef {
    index:     i64;
    tex_coord: i64;
}

# PbrMetallicRoughness: the metallic-roughness PBR parameter set.
# ---
# base_color_factor:          linear RGBA base color multiplier, default (1,1,1,1)
# base_color_texture:         base color texture reference
# metallic_factor:            metalness multiplier, default 1
# roughness_factor:           roughness multiplier, default 1
# metallic_roughness_texture: combined metallic-roughness texture reference
pub rec PbrMetallicRoughness {
    base_color_factor:          [4]f32;
    base_color_texture:         TextureRef;
    metallic_factor:            f32;
    roughness_factor:           f32;
    metallic_roughness_texture: TextureRef;
}

# Material: surface appearance parameters.
# ---
# pbr:                metallic-roughness parameters
# normal_texture:     tangent-space normal map reference
# normal_scale:       normal map strength, default 1
# occlusion_texture:  ambient occlusion texture reference
# occlusion_strength: occlusion strength, default 1
# emissive_texture:   emissive texture reference
# emissive_factor:    emissive color, default (0,0,0)
# alpha_mode:         alpha interpretation, default OPAQUE
# alpha_cutoff:       MASK-mode alpha threshold, default 0.5
# double_sided:       whether back faces are rendered
# name:               user-defined name, empty when absent
pub rec Material {
    pbr:                PbrMetallicRoughness;
    normal_texture:     TextureRef;
    normal_scale:       f32;
    occlusion_texture:  TextureRef;
    occlusion_strength: f32;
    emissive_texture:   TextureRef;
    emissive_factor:    [3]f32;
    alpha_mode:         AlphaMode;
    alpha_cutoff:       f32;
    double_sided:       bool;
    name:               StrView;
}

# Texture: a sampled image, pairing an image source with a sampler.
# ---
# source:  image index, or NONE
# sampler: sampler index, or NONE (use default sampling)
# name:    user-defined name, empty when absent
pub rec Texture {
    source:  i64;
    sampler: i64;
    name:    StrView;
}

# Image: image data referenced by a texture.
# ---
# uri:         source URI, empty when sourced from a buffer view
# mime_type:   MIME type, relevant for buffer-view-sourced images
# buffer_view: buffer view index supplying the bytes, or NONE
# name:        user-defined name, empty when absent
pub rec Image {
    uri:         StrView;
    mime_type:   StrView;
    buffer_view: i64;
    name:        StrView;
}

# Sampler: texture filtering and wrapping parameters.
# ---
# mag_filter: magnification filter enum, or NONE
# min_filter: minification filter enum, or NONE
# wrap_s:     S-axis wrap mode, spec default 10497 (REPEAT)
# wrap_t:     T-axis wrap mode, spec default 10497 (REPEAT)
# name:       user-defined name, empty when absent
pub rec Sampler {
    mag_filter: i64;
    min_filter: i64;
    wrap_s:     i64;
    wrap_t:     i64;
    name:       StrView;
}

# Skin: joint hierarchy and bind data for skeletal animation.
# ---
# inverse_bind_matrices: accessor index of the inverse bind matrices, or NONE
# skeleton:              index of the common root node, or NONE
# joints:                node indices used as joints, ordered
# name:                  user-defined name, empty when absent
pub rec Skin {
    inverse_bind_matrices: i64;
    skeleton:              i64;
    joints:                slice.Slice[i64];
    name:                  StrView;
}

# AnimationSampler: a keyframe interpolation source for an animation.
# ---
# input:         accessor index of keyframe input times
# output:        accessor index of keyframe output values
# interpolation: interpolation mode between keyframes
pub rec AnimationSampler {
    input:         i64;
    output:        i64;
    interpolation: Interpolation;
}

# AnimationChannel: a binding of a sampler to a target node property.
# ---
# sampler:     index of the driving sampler within the animation
# target_node: driven node index, or NONE
# target_path: driven node property
pub rec AnimationChannel {
    sampler:     i64;
    target_node: i64;
    target_path: TargetPath;
}

# Animation: a set of channels and the samplers they reference.
# ---
# samplers: keyframe samplers
# channels: channel bindings into the samplers
# name:     user-defined name, empty when absent
pub rec Animation {
    samplers: slice.Slice[AnimationSampler];
    channels: slice.Slice[AnimationChannel];
    name:     StrView;
}

# Document: the parsed glTF asset, holding every top-level array.
# ---
# asset:        document metadata
# scene:        default scene index, or NONE
# scenes:       scene definitions
# nodes:        node definitions
# meshes:       mesh definitions
# buffers:      buffer definitions
# buffer_views: buffer view definitions
# accessors:    accessor definitions
# materials:    material definitions
# textures:     texture definitions
# images:       image definitions
# samplers:     sampler definitions
# skins:        skin definitions
# animations:   animation definitions
pub rec Document {
    asset:        Asset;
    scene:        i64;
    scenes:       slice.Slice[Scene];
    nodes:        slice.Slice[Node];
    meshes:       slice.Slice[Mesh];
    buffers:      slice.Slice[Buffer];
    buffer_views: slice.Slice[BufferView];
    accessors:    slice.Slice[Accessor];
    materials:    slice.Slice[Material];
    textures:     slice.Slice[Texture];
    images:       slice.Slice[Image];
    samplers:     slice.Slice[Sampler];
    skins:        slice.Slice[Skin];
    animations:   slice.Slice[Animation];
}

test "doc: component_count covers every element type" {
    if (component_count(TYPE_SCALAR) != 1) { ret 1; }
    if (component_count(TYPE_VEC2) != 2) { ret 1; }
    if (component_count(TYPE_VEC3) != 3) { ret 1; }
    if (component_count(TYPE_VEC4) != 4) { ret 1; }
    if (component_count(TYPE_MAT2) != 4) { ret 1; }
    if (component_count(TYPE_MAT3) != 9) { ret 1; }
    if (component_count(TYPE_MAT4) != 16) { ret 1; }
    ret 0;
}

test "doc: component_size covers every component type" {
    if (component_size(COMPONENT_BYTE) != 1) { ret 1; }
    if (component_size(COMPONENT_UNSIGNED_BYTE) != 1) { ret 1; }
    if (component_size(COMPONENT_SHORT) != 2) { ret 1; }
    if (component_size(COMPONENT_UNSIGNED_SHORT) != 2) { ret 1; }
    if (component_size(COMPONENT_UNSIGNED_INT) != 4) { ret 1; }
    if (component_size(COMPONENT_FLOAT) != 4) { ret 1; }
    ret 0;
}

test "doc: element_size multiplies component count by component width" {
    var a: Accessor;
    a.element_type = TYPE_VEC3;
    a.component_type = COMPONENT_FLOAT;
    if (element_size(?a) != 12) { ret 1; }

    a.element_type = TYPE_SCALAR;
    a.component_type = COMPONENT_UNSIGNED_SHORT;
    if (element_size(?a) != 2) { ret 1; }
    ret 0;
}
