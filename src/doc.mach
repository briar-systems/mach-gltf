# the in-memory glTF 2.0 document model
#
# typed records mirroring the glTF top-level arrays and their cross-references.
# indices between arrays are `usize`, and an optional reference is `opt[usize]`
# that reads `none` when the document omitted it. every closed glTF enumeration
# (component type, element shape, topology, filters, wrap modes, interpolation,
# channel path, alpha mode) is a tag, so a parsed document holds no value
# outside the specification and no consumer handles an unrecognized code.
#
# OWNERSHIP. every string and every array in a Document is allocated from the
# allocator passed to `gltf.parse.parse_document`, and nothing points into the
# source JSON. a caller may therefore free or reuse the JSON bytes the moment
# parsing returns. the lifetime discipline is the allocator's: an arena freed
# wholesale, matching std.data.json's own Value tree, so there is no per-field
# teardown to call and no order to get wrong.
#
# strings are plain null-terminated `str`, so any std string function applies
# directly. an absent or empty member is an owned empty string rather than nil,
# so a consumer never nil-checks before comparing or formatting.
#
# this module is data plus the small numeric helpers that describe accessor
# element layout; the JSON bridge lives in gltf.parse.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use slice: std.collections.slice;

# glTF accessor component type (the OpenGL scalar type codes 5120 through 5126)
pub tag ComponentType: u8 {
    byte;
    unsigned_byte;
    short;
    unsigned_short;
    unsigned_int;
    float;
}

# glTF accessor element shape
pub tag AccessorType: u8 {
    scalar;
    vec2;
    vec3;
    vec4;
    mat2;
    mat3;
    mat4;
}

# glTF primitive topology (the OpenGL draw modes 0 through 6)
pub tag PrimitiveMode: u8 {
    points;
    lines;
    line_loop;
    line_strip;
    triangles;
    triangle_strip;
    triangle_fan;
}

# the GPU buffer a buffer view is intended for (34962 and 34963)
pub tag BufferTarget: u8 {
    array_buffer;
    element_array_buffer;
}

# texture magnification filter (9728 and 9729)
pub tag MagFilter: u8 {
    nearest;
    linear;
}

# texture minification filter (9728, 9729 and 9984 through 9987)
pub tag MinFilter: u8 {
    nearest;
    linear;
    nearest_mipmap_nearest;
    linear_mipmap_nearest;
    nearest_mipmap_linear;
    linear_mipmap_linear;
}

# texture coordinate wrap mode (33071, 33648 and 10497)
pub tag WrapMode: u8 {
    clamp_to_edge;
    mirrored_repeat;
    repeat;
}

# animation sampler interpolation mode
pub tag Interpolation: u8 {
    linear;
    step;
    cubic_spline;
}

# the node property an animation channel drives
pub tag TargetPath: u8 {
    translation;
    rotation;
    scale;
    weights;
}

# material alpha interpretation
pub tag AlphaMode: u8 {
    opaque;
    mask;
    blend;
}

# the largest accessor element (MAT4) has 16 components
pub val MAX_COMPONENTS: usize = 16;

# number of scalar components in an accessor element type
pub fun component_count(t: AccessorType) usize {
    if (sel t.scalar) { ret 1; }
    if (sel t.vec2)   { ret 2; }
    if (sel t.vec3)   { ret 3; }
    if (sel t.vec4)   { ret 4; }
    if (sel t.mat2)   { ret 4; }
    if (sel t.mat3)   { ret 9; }
    ret 16;
}

# byte width of a single accessor component
pub fun component_size(c: ComponentType) usize {
    if (sel c.byte)           { ret 1; }
    if (sel c.unsigned_byte)  { ret 1; }
    if (sel c.short)          { ret 2; }
    if (sel c.unsigned_short) { ret 2; }
    ret 4;
}

# document metadata from the required top-level `asset` object
# ---
# version:     glTF version string (e.g. "2.0")
# min_version: minimum version a client must support, empty when absent
# generator:   tool that produced the asset, empty when absent
# copyright:   copyright notice, empty when absent
pub rec Asset {
    version:     str;
    min_version: str;
    generator:   str;
    copyright:   str;
}

# a block of binary data referenced by buffer views
# ---
# byte_length: length of the buffer in bytes
# uri:         source URI, empty for the GLB BIN buffer (index 0)
# name:        user-defined name, empty when absent
pub rec Buffer {
    byte_length: usize;
    uri:         str;
    name:        str;
}

# a typed window into a buffer
# ---
# buffer:      index of the source buffer
# byte_offset: start offset into the buffer
# byte_length: length of the view in bytes
# byte_stride: element stride, 0 when tightly packed (unspecified)
# target:      intended GPU buffer, none when unspecified
# name:        user-defined name, empty when absent
pub rec BufferView {
    buffer:      usize;
    byte_offset: usize;
    byte_length: usize;
    byte_stride: usize;
    target:      opt[BufferTarget];
    name:        str;
}

# a typed view over a buffer view's bytes as element data
# ---
# buffer_view:    index of the source buffer view, none for an all-zero accessor
# byte_offset:    start offset relative to the buffer view
# component_type: scalar component type
# normalized:     whether integer components map to a normalized float range
# count:          number of elements
# element_type:   element shape (SCALAR..MAT4)
# min:            per-component minimum bounds, valid up to bounds_len
# max:            per-component maximum bounds, valid up to bounds_len
# bounds_len:     number of valid min/max components, 0 when bounds are absent
# has_min:        whether the accessor declared minimum bounds
# has_max:        whether the accessor declared maximum bounds
# name:           user-defined name, empty when absent
pub rec Accessor {
    buffer_view:    opt[usize];
    byte_offset:    usize;
    component_type: ComponentType;
    normalized:     bool;
    count:          usize;
    element_type:   AccessorType;
    min:            [16]f32;
    max:            [16]f32;
    bounds_len:     usize;
    has_min:        bool;
    has_max:        bool;
    name:           str;
}

# byte size of one accessor element (component_count * component_size)
pub fun element_size(a: *Accessor) usize {
    ret component_count(a.element_type) * component_size(a.component_type);
}

# total number of scalar components an accessor yields (count * component_count)
#
# the size a reader's output buffer must have to hold the accessor's data.
pub fun scalar_count(a: *Accessor) usize {
    ret a.count * component_count(a.element_type);
}

# one vertex attribute binding, a semantic name to an accessor index
# ---
# name:     attribute semantic (e.g. "POSITION", "NORMAL", "TEXCOORD_0")
# accessor: index of the accessor supplying the attribute's data
pub rec Attribute {
    name:     str;
    accessor: usize;
}

# a primitive morph target, its own set of attribute bindings
# ---
# attributes: the target's displaced attributes (POSITION, NORMAL, TANGENT)
pub rec MorphTarget {
    attributes: slice.Slice[Attribute];
}

# one drawable unit of a mesh
# ---
# attributes: vertex attribute bindings
# targets:    morph targets, empty when absent
# indices:    accessor index for element indices, none for non-indexed
# material:   material index, none for the default material
# mode:       primitive topology
pub rec Primitive {
    attributes: slice.Slice[Attribute];
    targets:    slice.Slice[MorphTarget];
    indices:    opt[usize];
    material:   opt[usize];
    mode:       PrimitiveMode;
}

# a set of primitives sharing a node's transform
# ---
# primitives: the mesh's drawable primitives
# weights:    default morph target weights, empty when absent
# name:       user-defined name, empty when absent
pub rec Mesh {
    primitives: slice.Slice[Primitive];
    weights:    slice.Slice[f32];
    name:       str;
}

# a scene-graph node with a local transform and optional attachments
# ---
# children:    indices of child nodes
# mesh:        attached mesh index, or none
# skin:        attached skin index, or none
# camera:      attached camera index, or none
# has_matrix:  whether a matrix transform was given (otherwise use TRS)
# matrix:      column-major local transform, valid when has_matrix
# translation: TRS translation, spec default (0,0,0)
# rotation:    TRS rotation quaternion (x,y,z,w), spec default (0,0,0,1)
# scale:       TRS scale, spec default (1,1,1)
# weights:     morph target weights override, empty when absent
# name:        user-defined name, empty when absent
pub rec Node {
    children:    slice.Slice[usize];
    mesh:        opt[usize];
    skin:        opt[usize];
    camera:      opt[usize];
    has_matrix:  bool;
    matrix:      [16]f32;
    translation: [3]f32;
    rotation:    [4]f32;
    scale:       [3]f32;
    weights:     slice.Slice[f32];
    name:        str;
}

# a set of root nodes to instantiate together
# ---
# nodes: indices of the scene's root nodes
# name:  user-defined name, empty when absent
pub rec Scene {
    nodes: slice.Slice[usize];
    name:  str;
}

# a material's reference to a texture and its UV set
# ---
# index:     texture index
# tex_coord: TEXCOORD attribute set index, spec default 0
pub rec TextureRef {
    index:     usize;
    tex_coord: usize;
}

# the metallic-roughness PBR parameter set
# ---
# base_color_factor:          linear RGBA base color multiplier, default (1,1,1,1)
# base_color_texture:         base color texture reference, or none
# metallic_factor:            metalness multiplier, default 1
# roughness_factor:           roughness multiplier, default 1
# metallic_roughness_texture: combined metallic-roughness texture reference, or none
pub rec PbrMetallicRoughness {
    base_color_factor:          [4]f32;
    base_color_texture:         opt[TextureRef];
    metallic_factor:            f32;
    roughness_factor:           f32;
    metallic_roughness_texture: opt[TextureRef];
}

# surface appearance parameters
# ---
# pbr:                metallic-roughness parameters
# normal_texture:     tangent-space normal map reference, or none
# normal_scale:       normal map strength, default 1
# occlusion_texture:  ambient occlusion texture reference, or none
# occlusion_strength: occlusion strength, default 1
# emissive_texture:   emissive texture reference, or none
# emissive_factor:    emissive color, default (0,0,0)
# alpha_mode:         alpha interpretation, default opaque
# alpha_cutoff:       mask-mode alpha threshold, default 0.5
# double_sided:       whether back faces are rendered
# name:               user-defined name, empty when absent
pub rec Material {
    pbr:                PbrMetallicRoughness;
    normal_texture:     opt[TextureRef];
    normal_scale:       f32;
    occlusion_texture:  opt[TextureRef];
    occlusion_strength: f32;
    emissive_texture:   opt[TextureRef];
    emissive_factor:    [3]f32;
    alpha_mode:         AlphaMode;
    alpha_cutoff:       f32;
    double_sided:       bool;
    name:               str;
}

# a sampled image, pairing an image source with a sampler
# ---
# source:  image index, or none
# sampler: sampler index, or none (use default sampling)
# name:    user-defined name, empty when absent
pub rec Texture {
    source:  opt[usize];
    sampler: opt[usize];
    name:    str;
}

# image data referenced by a texture
# ---
# uri:         source URI, empty when sourced from a buffer view
# mime_type:   MIME type, relevant for buffer-view-sourced images
# buffer_view: buffer view index supplying the bytes, or none
# name:        user-defined name, empty when absent
pub rec Image {
    uri:         str;
    mime_type:   str;
    buffer_view: opt[usize];
    name:        str;
}

# texture filtering and wrapping parameters
# ---
# mag_filter: magnification filter, none to let the client choose
# min_filter: minification filter, none to let the client choose
# wrap_s:     S-axis wrap mode, spec default repeat
# wrap_t:     T-axis wrap mode, spec default repeat
# name:       user-defined name, empty when absent
pub rec Sampler {
    mag_filter: opt[MagFilter];
    min_filter: opt[MinFilter];
    wrap_s:     WrapMode;
    wrap_t:     WrapMode;
    name:       str;
}

# joint hierarchy and bind data for skeletal animation
# ---
# inverse_bind_matrices: accessor index of the inverse bind matrices, or none
# skeleton:              index of the common root node, or none
# joints:                node indices used as joints, ordered
# name:                  user-defined name, empty when absent
pub rec Skin {
    inverse_bind_matrices: opt[usize];
    skeleton:              opt[usize];
    joints:                slice.Slice[usize];
    name:                  str;
}

# a keyframe interpolation source for an animation
# ---
# input:         accessor index of keyframe input times
# output:        accessor index of keyframe output values
# interpolation: interpolation mode between keyframes
pub rec AnimationSampler {
    input:         usize;
    output:        usize;
    interpolation: Interpolation;
}

# a binding of a sampler to a target node property
# ---
# sampler:     index of the driving sampler within the animation
# target_node: driven node index, or none
# target_path: driven node property
pub rec AnimationChannel {
    sampler:     usize;
    target_node: opt[usize];
    target_path: TargetPath;
}

# a set of channels and the samplers they reference
# ---
# samplers: keyframe samplers
# channels: channel bindings into the samplers
# name:     user-defined name, empty when absent
pub rec Animation {
    samplers: slice.Slice[AnimationSampler];
    channels: slice.Slice[AnimationChannel];
    name:     str;
}

# the parsed glTF asset, holding every top-level array
# ---
# asset:        document metadata
# scene:        default scene index, or none
# scenes:       scene definitions
# nodes:        node definitions
# meshes:       mesh definitions
# buffers:      buffer definitions
# buffer_views: buffer view definitions
# accessors:    accessor definitions
# materials:    material definitions
# textures:     texture definitions
# images:       image definitions
# samplers:     sampler definitions
# skins:        skin definitions
# animations:   animation definitions
pub rec Document {
    asset:        Asset;
    scene:        opt[usize];
    scenes:       slice.Slice[Scene];
    nodes:        slice.Slice[Node];
    meshes:       slice.Slice[Mesh];
    buffers:      slice.Slice[Buffer];
    buffer_views: slice.Slice[BufferView];
    accessors:    slice.Slice[Accessor];
    materials:    slice.Slice[Material];
    textures:     slice.Slice[Texture];
    images:       slice.Slice[Image];
    samplers:     slice.Slice[Sampler];
    skins:        slice.Slice[Skin];
    animations:   slice.Slice[Animation];
}

test "doc: component_count covers every element type" {
    if (component_count(AccessorType.scalar{}) != 1) { ret 1; }
    if (component_count(AccessorType.vec2{}) != 2) { ret 1; }
    if (component_count(AccessorType.vec3{}) != 3) { ret 1; }
    if (component_count(AccessorType.vec4{}) != 4) { ret 1; }
    if (component_count(AccessorType.mat2{}) != 4) { ret 1; }
    if (component_count(AccessorType.mat3{}) != 9) { ret 1; }
    if (component_count(AccessorType.mat4{}) != 16) { ret 1; }
    ret 0;
}

test "doc: component_size covers every component type" {
    if (component_size(ComponentType.byte{}) != 1) { ret 1; }
    if (component_size(ComponentType.unsigned_byte{}) != 1) { ret 1; }
    if (component_size(ComponentType.short{}) != 2) { ret 1; }
    if (component_size(ComponentType.unsigned_short{}) != 2) { ret 1; }
    if (component_size(ComponentType.unsigned_int{}) != 4) { ret 1; }
    if (component_size(ComponentType.float{}) != 4) { ret 1; }
    ret 0;
}

test "doc: element_size multiplies component count by component width" {
    var a: Accessor;
    a.element_type = AccessorType.vec3{};
    a.component_type = ComponentType.float{};
    if (element_size(?a) != 12) { ret 1; }

    a.element_type = AccessorType.scalar{};
    a.component_type = ComponentType.unsigned_short{};
    if (element_size(?a) != 2) { ret 1; }
    ret 0;
}
